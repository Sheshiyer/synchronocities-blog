---
interface Props {
  title?: string;
  description?: string;
  action?: string;
  placeholder?: string;
  eyebrow?: string;
}

const {
  title = 'Search the archive',
  description = 'Search across titles, concepts, tags, and clusters.',
  action = '/journeys',
  placeholder = 'Search titles, concepts, tags, and clusters',
  eyebrow = 'Archive Atlas',
} = Astro.props;
---

<section
  id="archive-search"
  style="display: grid; gap: 1rem; padding: 1.15rem; border-radius: 1rem; border: 1px solid rgba(138,155,168,0.12); background: linear-gradient(180deg, rgba(14,20,40,0.82), rgba(7,11,29,0.96));"
>
  <div style="display: grid; gap: 0.55rem; max-width: 40rem;">
    <span style="font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-sacred-gold); opacity: 0.72;">
      {eyebrow}
    </span>
    <h2 style="font-family: var(--font-display); font-size: clamp(1.25rem, 2.2vw, 1.85rem); line-height: 1.08; color: var(--color-parchment);">
      {title}
    </h2>
    <p style="font-family: var(--font-body); font-size: 0.98rem; line-height: 1.7; color: var(--color-muted-silver); opacity: 0.82; max-width: none;">
      {description}
    </p>
  </div>

  <form action={action} method="get" style="display: grid; gap: 0.85rem;">
    <label style="display: grid; gap: 0.45rem;">
      <span style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-muted-silver); opacity: 0.74;">
        Query
      </span>
      <input
        type="search"
        name="q"
        placeholder={placeholder}
        style="width: 100%; border-radius: 0.9rem; border: 1px solid rgba(138,155,168,0.18); background: rgba(7,11,29,0.72); color: var(--color-parchment); padding: 0.95rem 1rem; font-family: var(--font-body); font-size: 0.98rem;"
      />
    </label>

    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
      <button
        type="submit"
        style="font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 0.8rem 1rem; border-radius: 999px; border: 1px solid rgba(197,160,23,0.24); background: rgba(197,160,23,0.08); color: var(--color-sacred-gold);"
      >
        Search
      </button>
      <a
        href="/journeys?preset=foundational"
        style="font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 0.8rem 1rem; border-radius: 999px; border: 1px solid rgba(16,181,167,0.2); background: rgba(16,181,167,0.08); color: var(--color-coherence-emerald);"
      >
        Open Foundational Essays
      </a>
    </div>
  </form>
</section>
