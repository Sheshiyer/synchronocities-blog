---
const projects = [
  { name: 'Somatic Canticles', kind: 'THE BOOK', note: 'A trilogy of embodied remembering.', href: 'https://www.tryambakam.space/?linear=1#somatic-canticles' },
  { name: 'Urania 137', kind: 'THE INSTRUMENT', note: 'A reading field for pattern and inquiry.', href: 'https://urania.tryambakam.space/' },
  { name: 'The Fivefold Atlas', kind: 'THE ANATOMY', note: 'Explore Selemene through five kosha lenses.', href: 'https://atlas.tryambakam.space/' },
];
---
<aside class="noesis-discovery" aria-label="Explore Tryambakam Noesis" data-noesis-discovery>
  <div class="publication-invitation">
    <div>
      <p class="discovery-label">A LETTER FROM THE SAME FIELD</p>
      <p class="publication-title">The Why Chromosome</p>
      <p>Essays and field notes on attention, symbolic systems, and the choices our tools shape. By Shesh Iyer.</p>
    </div>
    <a class="subscribe" aria-label="Subscribe to The Why Chromosome on Substack" href="https://thewhychromosome.substack.com/subscribe" target="_blank" rel="noopener noreferrer">Subscribe on Substack <span aria-hidden="true">↗</span></a>
  </div>
  <details>
    <summary>Explore the Tryambakam Noesis projects</summary>
    <div class="project-grid">
      {projects.map(({ name, kind, note, href }) => (
        <a class="project" href={href} target="_blank" rel="noopener noreferrer">
          <span class="discovery-label">{kind}</span>
          <span class="project-title">{name} <span aria-hidden="true">↗</span></span>
          <span class="project-note">{note}</span>
        </a>
      ))}
    </div>
    <a class="all-projects" href="https://www.tryambakam.space/" target="_blank" rel="noopener noreferrer">Enter Tryambakam Noesis <span aria-hidden="true">↗</span></a>
  </details>
</aside>
<script>
  // Pause at a section boundary midway through the article; without JS the
  // same invitation remains available after the article text.
  document.querySelectorAll<HTMLElement>('[data-noesis-discovery]').forEach((invitation) => {
    const reading = invitation.closest('#post-reading');
    if (!reading) return;
    const sections = Array.from(reading.children).filter((node) => node.tagName === 'H2');
    if (sections.length >= 2) reading.insertBefore(invitation, sections[Math.floor(sections.length / 2)]);
  });
</script>
<style>
  .noesis-discovery { margin-block: 2.5rem; padding: clamp(1rem, 2vw, 1.5rem); border: 1px solid rgba(197,160,23,.35); border-radius: .75rem; background: var(--color-deep-surface); color: var(--color-parchment); font-family: var(--font-body); }
  .publication-invitation { display: flex; gap: 1.25rem; align-items: center; }
  .publication-invitation > div { flex: 1; min-width: 0; }
  .discovery-label { display: block; margin: 0 0 .6rem; color: var(--color-sacred-gold); font: .6rem/1.6 var(--font-mono); letter-spacing: .1em; }
  .publication-title { margin: 0 0 .65rem; font-family: var(--font-display); font-size: clamp(1rem, 2vw, 1.3rem); line-height: 1.4; }
  .publication-invitation p:not(.discovery-label):not(.publication-title) { margin: 0; color: var(--color-muted-silver-strong); font-size: .9rem; line-height: 1.65; }
  .subscribe { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 44px; padding: .65rem .9rem; border-radius: .3rem; background: var(--color-sacred-gold); color: var(--color-void-black); font-size: .8rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .subscribe:hover { background: var(--color-parchment); }
  details { border-top: 1px solid rgba(138,155,168,.2); margin-top: 1.25rem; padding-top: .5rem; }
  summary { padding-block: .6rem; min-height: 44px; cursor: pointer; color: var(--color-muted-silver-strong); font-size: .8rem; }
  .project-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .75rem; margin-top: .5rem; }
  .project { display: flex; flex-direction: column; padding: 1rem; border: 1px solid rgba(138,155,168,.25); border-radius: .4rem; background: var(--color-void-black); text-decoration: none; }
  .project:hover { border-color: var(--color-sacred-gold); }
  .project-title { font-size: .95rem; line-height: 1.4; color: var(--color-parchment); }
  .project-note { margin-top: .5rem; color: var(--color-muted-silver-strong); font-size: .8rem; line-height: 1.6; }
  .all-projects { display: inline-block; padding-block: .8rem; color: var(--color-sacred-gold); font-size: .8rem; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--color-sacred-gold); outline-offset: 4px; }
  @media (max-width: 700px) { .publication-invitation { flex-direction: column; align-items: stretch; } .project-grid { grid-template-columns: 1fr; } .subscribe { white-space: normal; } }
</style>
