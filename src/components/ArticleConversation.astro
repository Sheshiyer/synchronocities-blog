---
interface Props { title: string; url: string }
const { title, url } = Astro.props;
const publications = [
  { name: 'Harsh Truths', host: 'harshtruths3321', note: 'Consciousness, perception, and the assumptions that shape a worldview.' },
  { name: 'Steven A. Young', host: 'stevenalexanderyoung', note: 'Alchemical philosophy and questions about the connecting medium.' },
];
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---

<section class="conversation" aria-labelledby="conversation-heading" data-article-conversation data-title={title} data-url={url}>
  <p class="eyebrow">CONTINUE THE CONVERSATION</p>
  <h2 id="conversation-heading">Follow the voices in this essay</h2>
  <p class="intro">Read the authors in their own words, and subscribe to follow their work.</p>
  <div class="publications">
    {publications.map(({ name, host, note }) => (
      <article class="publication">
        <h3>{name}</h3>
        <p>{note}</p>
        <iframe src={`https://${host}.substack.com/embed`} title={`Subscribe to ${name} on Substack`} width="480" height="320" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        <a class="action" href={`https://${host}.substack.com/subscribe`} target="_blank" rel="noopener noreferrer">Subscribe to {name} <span aria-hidden="true">↗</span></a>
        <a class="read" href={`https://${host}.substack.com/`} target="_blank" rel="noopener noreferrer">Read on Substack</a>
      </article>
    ))}
  </div>
  <div class="sharing">
    <h3>Pass the clearing onward</h3>
    <p>Share this essay with someone thinking about memory, attention, or witness.</p>
    <div class="actions">
      <button type="button" data-copy hidden>Copy article link</button>
      <button type="button" data-share hidden>Share…</button>
      <a class="action" href={xUrl} target="_blank" rel="noopener noreferrer">Share on X</a>
      <a class="action" href={linkedinUrl} target="_blank" rel="noopener noreferrer">Share on LinkedIn</a>
    </div>
    <p class="status" role="status" aria-live="polite" data-status></p>
    <label class="manual" data-manual hidden>Article link<input type="text" value={url} readonly aria-label="Article link to copy" /></label>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-article-conversation]').forEach((section) => {
    const url = section.dataset.url!;
    const title = section.dataset.title!;
    const status = section.querySelector<HTMLElement>('[data-status]')!;
    const copy = section.querySelector<HTMLButtonElement>('[data-copy]')!;
    const share = section.querySelector<HTMLButtonElement>('[data-share]')!;
    copy.hidden = false;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = 'Article link copied.';
      } catch {
        const manual = section.querySelector<HTMLElement>('[data-manual]')!;
        manual.hidden = false;
        const input = manual.querySelector<HTMLInputElement>('input')!;
        input.focus(); input.select();
        status.textContent = 'Select and copy the article link below.';
      }
    });
    if (navigator.share) {
      share.hidden = false;
      share.addEventListener('click', async () => {
        try { await navigator.share({ title, url }); }
        catch (error) {
          if (!(error instanceof DOMException && error.name === 'AbortError')) {
            status.textContent = 'Use the sharing links or copy the article link.';
          }
        }
      });
    }
  });
</script>

<style>
  .conversation { margin-block: 3rem; padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--article-border, #38444e); border-radius: 1rem; background: var(--article-surface, #121820); color: #edf1f3; }
  .eyebrow { font-size: .7rem; letter-spacing: .16em; color: #d6bb65; }
  h2 { margin: .75rem 0; font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.25; }
  h3 { font-size: 1.15rem; margin: 0 0 .65rem; }
  .intro, .publication p, .sharing p { color: #bdc8d2; line-height: 1.65; }
  .publications { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  .publication { min-width: 0; padding: 1.25rem; background: #0c1118; border: 1px solid #38444e; border-radius: .75rem; }
  iframe { display: block; width: 100%; max-width: 480px; height: 320px; margin: 1rem auto; border: 0; border-radius: .5rem; background: #fff; }
  .action, button { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 44px; padding: .65rem 1rem; border: 1px solid #73838f; border-radius: .4rem; color: #edf1f3; background: transparent; font: inherit; font-size: .85rem; text-decoration: none; cursor: pointer; }
  .action:hover, button:hover { border-color: #d6bb65; color: #f1d985; }
  a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid #f1d985; outline-offset: 4px; }
  .read { display: block; width: fit-content; margin-top: .65rem; padding-block: .65rem; color: #d6bb65; font-size: .85rem; }
  .sharing { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #38444e; }
  .actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1rem; }
  .status { font-size: .85rem; min-height: 1.5em; }
  .manual { font-size: .85rem; }
  input { display: block; box-sizing: border-box; width: 100%; margin-top: .5rem; padding: .75rem; color: #edf1f3; background: #0c1118; border: 1px solid #73838f; border-radius: .4rem; }
  [hidden] { display: none !important; }
  @media (max-width: 600px) {
    .conversation { padding: 0; border: 0; background: transparent; }
    .publication { padding: .75rem; }
    iframe { height: 400px; }
  }
  @media (min-width: 1200px) { .publications { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
