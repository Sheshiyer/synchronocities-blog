---
import type { ArchiveRecord, RelatedArchiveRecord } from '../lib/archive';

interface Props {
  currentTitle: string;
  series?: string;
  related: RelatedArchiveRecord[];
  seriesCompanions: ArchiveRecord[];
}

const { currentTitle, series, related, seriesCompanions } = Astro.props;

function formatKind(record: ArchiveRecord) {
  if (record.card) {
    return `Travel Arc ${record.card}`;
  }

  if (record.entryKind === 'hub') {
    return 'Hub';
  }

  if (record.entryKind === 'reference') {
    return 'Reference';
  }

  switch (record.articleMode) {
    case 'signal-essay':
      return 'Signal Essay';
    case 'field-note':
      return 'Field Note';
    case 'research-essay':
      return 'Research Essay';
    default:
      return 'Essay';
  }
}

const visibleSeriesCompanions = seriesCompanions.filter(
  (record) => !related.some((item) => item.record.slug === record.slug)
);
---

{(related.length > 0 || visibleSeriesCompanions.length > 0) && (
  <section class="mt-16 md:mt-20">
    <div class="mb-8 flex items-center gap-4">
      <span
        style="font-family: var(--font-mono); font-size: clamp(0.65rem, 0.7vw, 0.75rem); letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-sacred-gold); opacity: 0.72;"
      >
        Continue The Thread
      </span>
      <div style="flex: 1; height: 1px; background: linear-gradient(90deg, rgba(197,160,23,0.24), transparent);" />
    </div>

    <div style="display: grid; gap: 1rem;">
      {related.length > 0 && (
        <div style="display: grid; gap: 1rem;">
          <p style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.78; max-width: none;">
            {currentTitle} connects into nearby essays, hubs, and journey nodes through explicit editorial links, shared concepts, and structural overlap.
          </p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
            {related.map(({ record, reasons }) => (
              <a href={`/posts/${record.slug}`} style="display: grid; gap: 0.75rem; padding: 1rem; border-radius: 1rem; border: 1px solid rgba(138,155,168,0.12); background: linear-gradient(180deg, rgba(14,20,40,0.72), rgba(7,11,29,0.94));">
                <div style="display: flex; justify-content: space-between; gap: 0.75rem; align-items: baseline;">
                  <span style="font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-coherence-emerald); opacity: 0.8;">
                    {formatKind(record)}
                  </span>
                  <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-muted-silver); opacity: 0.5;">
                    {record.readTimeMinutes ? `${record.readTimeMinutes} min` : ''}
                  </span>
                </div>

                <h3 style="font-family: var(--font-display); font-size: 1.2rem; line-height: 1.1; color: var(--color-parchment);">
                  {record.title}
                </h3>

                {record.excerpt && (
                  <p style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.8; max-width: none;">
                    {record.excerpt}
                  </p>
                )}

                {/* Relationship reasons used for scoring only, not rendered to readers */}
              </a>
            ))}
          </div>
        </div>
      )}

      {visibleSeriesCompanions.length > 0 && (
        <div style="display: grid; gap: 0.85rem;">
          <p style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-muted-silver); opacity: 0.64;">
            {series ? `Also in ${series}` : 'Series companions'}
          </p>
          <div style="display: grid; gap: 0.7rem;">
            {visibleSeriesCompanions.map((record) => (
              <a href={`/posts/${record.slug}`} style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem; align-items: baseline; padding: 0.9rem 1rem; border-radius: 0.85rem; border: 1px solid rgba(138,155,168,0.08); background: rgba(14,20,40,0.32);">
                <span style="font-family: var(--font-display); font-size: 1rem; color: var(--color-parchment);">
                  {record.title}
                </span>
                <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-muted-silver); opacity: 0.52;">
                  {formatKind(record)}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}
