---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCardByNumeral } from '../lib/tarot';
import { getCardPalette } from '../lib/cardColors';
import JourneysAnimator from '../components/JourneysAnimator';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const cardPosts = allPosts.filter((p) => p.data.card);

const sortedCardPosts = [...cardPosts].sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="The Shesh Travelogue" description="Field-movement entries. Each post sits at a tarot position on the spiral. The most recent reading appears first.">
  <header
    class="fixed top-0 left-0 right-0 z-20 flex flex-wrap items-center justify-between gap-3 backdrop-blur-md"
    style="padding: 2vh 4vw; background: rgba(7,11,29,0.85);"
  >
    <a href="/">
      <span
        style="font-family: var(--font-display); font-size: clamp(0.85rem, 1vw, 1.1rem); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-sacred-gold);"
      >
        Synchronocities
      </span>
    </a>
    <nav class="flex max-w-[58vw] items-center justify-end gap-3 overflow-x-auto whitespace-nowrap pl-3 sm:max-w-none sm:gap-5 sm:pl-0" style="font-family: var(--font-mono); font-size: clamp(0.63rem, 0.75vw, 0.8rem); scrollbar-width: none;">
      <a href="/" class="transition-colors hover:text-[var(--color-sacred-gold)]" style="color: var(--color-muted-silver);">Depth</a>
      <a href="/journeys" style="color: var(--color-sacred-gold);">Journeys</a>
      <a href="/research" class="transition-colors hover:text-[var(--color-sacred-gold)]" style="color: var(--color-muted-silver);">Research</a>
      <a href="/maps" class="transition-colors hover:text-[var(--color-sacred-gold)]" style="color: var(--color-muted-silver);">Maps</a>
    </nav>
  </header>

  <main style="padding-top: 14vh; padding-bottom: 12vh;">
    <section style="padding: 0 6vw 8vh;">
      <div style="display: grid; gap: 1.5rem; max-width: 72rem;">
        <div style="display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center;">
          <span
            style="font-family: var(--font-mono); font-size: clamp(0.65rem, 0.7vw, 0.75rem); letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-sacred-gold); opacity: 0.68;"
          >
            Travelogue Lane
          </span>
          <span
            style="font-family: var(--font-mono); font-size: clamp(0.62rem, 0.68vw, 0.72rem); color: var(--color-muted-silver); opacity: 0.42;"
          >
            {sortedCardPosts.length} travel entries
          </span>
        </div>

        <h1
          data-anim="hero-title"
          style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 600; line-height: 1.02; color: var(--color-parchment);"
        >
          The Shesh Travelogue.
        </h1>

        <p
          data-anim="hero-sub"
          style="font-family: var(--font-body); font-size: clamp(0.96rem, 1.05vw, 1.15rem); line-height: 1.75; color: var(--color-muted-silver); max-width: 52rem; opacity: 0.78;"
        >
          Field-movement entries. The body went here, the field changed, the tarot card names the position. Each entry sits at a node on the spiral.
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
          <a
            href="#travelogue-sequence"
            style="font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 0.75rem 0.95rem; border-radius: 999px; border: 1px solid rgba(197,160,23,0.24); background: rgba(197,160,23,0.08); color: var(--color-sacred-gold);"
          >
            Read The Travelogue
          </a>
          <a
            href="/research"
            style="font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 0.75rem 0.95rem; border-radius: 999px; border: 1px solid rgba(16,181,167,0.2); background: rgba(16,181,167,0.08); color: var(--color-coherence-emerald);"
          >
            Browse Research
          </a>
          <a
            href="/maps"
            style="font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 0.75rem 0.95rem; border-radius: 999px; border: 1px solid rgba(138,155,168,0.18); background: rgba(14,20,40,0.5); color: var(--color-muted-silver);"
          >
            Open Maps & Indexes
          </a>
        </div>
      </div>
    </section>

    {sortedCardPosts.length > 0 && (
      <section id="travelogue-sequence" style="padding: 0 6vw 12vh;">
        <div data-anim="section-label" style="display: flex; align-items: center; gap: 2vw; margin-bottom: 5vh;">
          <span data-anim="section-text" style="font-family: var(--font-mono); font-size: clamp(0.6rem, 0.65vw, 0.7rem); letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-sacred-gold); opacity: 0.6; white-space: nowrap;">
            Field Sequence
          </span>
          <div data-anim="section-line" style="flex: 1; height: 1px; background: linear-gradient(90deg, rgba(197,160,23,0.25), transparent);" />
        </div>

        <p style="font-family: var(--font-body); font-size: clamp(0.92rem, 1vw, 1.05rem); line-height: 1.75; color: var(--color-muted-silver); max-width: 44rem; opacity: 0.76; margin-bottom: 2rem;">
          Each entry is dated and tarot-anchored. The card numeral marks the position; the date marks when the body was there.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 25vw), 1fr)); gap: 1.5vw;">
          {sortedCardPosts.map((post) => {
            const card = post.data.card ? getCardByNumeral(post.data.card) : null;
            const palette = post.data.card ? getCardPalette(post.data.card) : null;
            const accent = palette?.accentColor || '#C5A017';
            const bg = palette?.backgroundColor || '#0E1428';
            const gFrom = palette?.gradientFrom || '#070B1D';
            const gVia = palette?.gradientVia || '#0E1428';

            return (
              <a
                href={`/posts/${post.id}`}
                data-anim="arcana-card"
                class="journeys-card group block cursor-pointer relative overflow-hidden transition-all duration-500"
                style={`border-radius: 0.8vw; border: 1px solid ${accent}15; background: linear-gradient(160deg, ${gFrom}, ${gVia});`}
              >
                {palette?.textureSrc && (
                  <div class="absolute inset-0 transition-all duration-700 group-hover:scale-105 group-hover:opacity-30" style="opacity: 0.12;">
                    <img src={palette.textureSrc} alt="" class="w-full h-full object-cover" style="filter: saturate(0.3);" />
                    <div class="absolute inset-0" style={`background: linear-gradient(180deg, ${bg}DD 0%, ${bg}99 50%, ${bg}DD 100%);`} />
                  </div>
                )}

                <div
                  class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
                  style={`background: radial-gradient(ellipse at 50% 80%, ${accent}15 0%, transparent 60%); filter: blur(2vw);`}
                />

                <div
                  class="absolute inset-0 rounded-[0.8vw] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                  style={`box-shadow: inset 0 0 0 1px ${accent}30, 0 0 3vw ${accent}10;`}
                />

                <div class="relative" style="padding: 2.5vh 2vw;">
                  <div style="display: flex; align-items: baseline; gap: 1vw; margin-bottom: 1.5vh;">
                    <span data-anim="card-numeral" class="transition-all duration-500 group-hover:opacity-25" style={`font-family: var(--font-display); font-size: clamp(2rem, 3vw, 3.5rem); font-weight: 700; line-height: 1; color: ${accent}; opacity: 0.12;`}>
                      {post.data.card}
                    </span>
                    {card && (
                      <span style={`font-family: var(--font-mono); font-size: clamp(0.55rem, 0.6vw, 0.65rem); letter-spacing: 0.18em; text-transform: uppercase; color: ${accent}; opacity: 0.5;`}>
                        {card.thothName}
                      </span>
                    )}
                  </div>

                  <h3
                    data-anim="card-title"
                    class="transition-colors duration-300"
                    style={`font-family: var(--font-display); font-size: clamp(1rem, 1.3vw, 1.45rem); font-weight: 500; line-height: 1.25; color: var(--color-parchment); margin-bottom: 1.2vh;`}
                  >
                    {post.data.title}
                  </h3>

                  <div style="display: flex; align-items: center; gap: 1vw;">
                    <time style={`font-family: var(--font-mono); font-size: clamp(0.55rem, 0.58vw, 0.62rem); color: var(--color-muted-silver); opacity: 0.4;`}>
                      {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </time>
                    {card && (
                      <>
                        <span style={`width: 0.3vw; height: 0.3vw; border-radius: 50%; background: ${accent}; opacity: 0.2;`} />
                        <span style={`font-family: var(--font-mono); font-size: clamp(0.5rem, 0.55vw, 0.6rem); color: var(--color-muted-silver); opacity: 0.3;`}>
                          {card.heroPhase}
                        </span>
                      </>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </main>

  <JourneysAnimator client:load />
</BaseLayout>
