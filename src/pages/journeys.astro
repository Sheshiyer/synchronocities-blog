---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCardByNumeral } from '../lib/tarot';
import { getCardPalette } from '../lib/cardColors';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// Separate into card posts (Major Arcana journey) and other posts
const cardPosts = allPosts.filter((p) => p.data.card);
const otherPosts = allPosts.filter((p) => !p.data.card);

// Sort card posts by journey order
const cardOrder: Record<string, number> = {
  '0': 0, 'IX': 9, 'XIV': 14, 'XVI': 16, 'XVII': 17, 'XVIII': 18, 'XX': 20, 'XXI': 21,
};
const sortedCardPosts = [...cardPosts].sort((a, b) => {
  const aOrder = cardOrder[a.data.card || ''] ?? 99;
  const bOrder = cardOrder[b.data.card || ''] ?? 99;
  return aOrder - bOrder;
});

// Sort other posts by date (newest first)
const sortedOtherPosts = [...otherPosts].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Collect all unique tags
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Journeys" description="All writings — travel journals, consciousness architecture, vedic mathematics, and more.">
  <!-- Header -->
  <header class="fixed top-0 left-0 right-0 z-20 flex items-center justify-between backdrop-blur-md"
    style="padding: 2vh 4vw; background: rgba(7,11,29,0.8);">
    <a href="/">
      <span style="font-family: var(--font-display); font-size: clamp(0.85rem, 1vw, 1.1rem); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-sacred-gold);">
        Synchronocities
      </span>
    </a>
    <nav class="flex" style="gap: 2.5vw; font-family: var(--font-mono); font-size: clamp(0.7rem, 0.75vw, 0.8rem);">
      <a href="/" class="transition-colors hover:text-[var(--color-sacred-gold)]" style="color: var(--color-muted-silver);">
        Depth
      </a>
      <a href="/journeys" style="color: var(--color-sacred-gold);">
        Journeys
      </a>
    </nav>
  </header>

  <main style="padding-top: 14vh; padding-bottom: 12vh;">

    <!-- ═══ HERO ═══ -->
    <section style="padding: 0 6vw 10vh;">
      <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 600; line-height: 1.05; color: var(--color-parchment); margin-bottom: 2vh;">
        Journeys
      </h1>
      <p style="font-family: var(--font-body); font-size: clamp(0.9rem, 1.05vw, 1.15rem); line-height: 1.7; color: var(--color-muted-silver); max-width: 45vw; opacity: 0.7;">
        {allPosts.length} writings across consciousness architecture, travel journals, vedic mathematics, enneagram frameworks, and esoteric systems thinking.
      </p>
    </section>

    <!-- ═══ MAJOR ARCANA ═══ -->
    {sortedCardPosts.length > 0 && (
      <section style="padding: 0 6vw 12vh;">
        <div style="display: flex; align-items: center; gap: 2vw; margin-bottom: 5vh;">
          <span style="font-family: var(--font-mono); font-size: clamp(0.6rem, 0.65vw, 0.7rem); letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-sacred-gold); opacity: 0.6; white-space: nowrap;">
            Major Arcana
          </span>
          <div style="flex: 1; height: 1px; background: linear-gradient(90deg, rgba(197,160,23,0.2), transparent);" />
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 28vw), 1fr)); gap: 2vw;">
          {sortedCardPosts.map((post) => {
            const card = post.data.card ? getCardByNumeral(post.data.card) : null;
            const palette = post.data.card ? getCardPalette(post.data.card) : null;
            return (
              <a
                href={`/posts/${post.id}`}
                class="group block cursor-pointer transition-all duration-300"
                style={`padding: 2.5vh 2vw; border-radius: 0.6vw; border: 1px solid rgba(197,160,23,0.08); background: rgba(14,20,40,0.4);`}
              >
                <div style="display: flex; align-items: baseline; gap: 1.2vw; margin-bottom: 1.2vh;">
                  <span style={`font-family: var(--font-display); font-size: clamp(1.8rem, 2.5vw, 3rem); font-weight: 700; line-height: 1; color: ${palette?.accentColor || 'var(--color-sacred-gold)'}; opacity: 0.15;`}>
                    {post.data.card}
                  </span>
                  {card && (
                    <span style={`font-family: var(--font-mono); font-size: clamp(0.55rem, 0.6vw, 0.65rem); letter-spacing: 0.15em; text-transform: uppercase; color: ${palette?.accentColor || 'var(--color-sacred-gold)'}; opacity: 0.5;`}>
                      {card.thothName}
                    </span>
                  )}
                </div>

                <h3
                  class="group-hover:text-[var(--color-sacred-gold)] transition-colors"
                  style="font-family: var(--font-display); font-size: clamp(1rem, 1.2vw, 1.35rem); font-weight: 500; line-height: 1.3; color: var(--color-parchment); margin-bottom: 1vh;"
                >
                  {post.data.title}
                </h3>

                <div style="display: flex; align-items: center; gap: 1vw;">
                  <time style="font-family: var(--font-mono); font-size: clamp(0.55rem, 0.6vw, 0.65rem); color: var(--color-muted-silver); opacity: 0.5;">
                    {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                  {card && (
                    <span style="font-family: var(--font-mono); font-size: clamp(0.5rem, 0.55vw, 0.6rem); color: var(--color-muted-silver); opacity: 0.3;">
                      {card.heroPhase}
                    </span>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- ═══ TOPICS ═══ -->
    {sortedTags.length > 0 && (
      <section style="padding: 0 6vw 10vh;">
        <div style="display: flex; align-items: center; gap: 2vw; margin-bottom: 4vh;">
          <span style="font-family: var(--font-mono); font-size: clamp(0.6rem, 0.65vw, 0.7rem); letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-sacred-gold); opacity: 0.6; white-space: nowrap;">
            Topics
          </span>
          <div style="flex: 1; height: 1px; background: linear-gradient(90deg, rgba(197,160,23,0.2), transparent);" />
        </div>

        <div class="flex flex-wrap" style="gap: 0.6vw;">
          {sortedTags.slice(0, 30).map(([tag, count]) => (
            <span
              class="transition-colors cursor-default"
              style={`font-family: var(--font-mono); font-size: clamp(0.6rem, 0.65vw, 0.7rem); padding: 0.6vh 1vw; border-radius: 9999px; color: var(--color-muted-silver); opacity: 0.5; border: 1px solid rgba(138,155,168,0.1);`}
            >
              {tag}
              <span style="opacity: 0.4; margin-left: 0.3vw;">{count}</span>
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- ═══ ALL WRITINGS ═══ -->
    <section style="padding: 0 6vw;">
      <div style="display: flex; align-items: center; gap: 2vw; margin-bottom: 5vh;">
        <span style="font-family: var(--font-mono); font-size: clamp(0.6rem, 0.65vw, 0.7rem); letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-sacred-gold); opacity: 0.6; white-space: nowrap;">
          All Writings
        </span>
        <span style="font-family: var(--font-mono); font-size: clamp(0.55rem, 0.6vw, 0.65rem); color: var(--color-muted-silver); opacity: 0.3;">
          {sortedOtherPosts.length}
        </span>
        <div style="flex: 1; height: 1px; background: linear-gradient(90deg, rgba(197,160,23,0.2), transparent);" />
      </div>

      <div>
        {sortedOtherPosts.map((post) => (
          <a
            href={`/posts/${post.id}`}
            class="group block cursor-pointer transition-colors"
            style={`display: grid; grid-template-columns: 8vw 1fr auto; align-items: baseline; gap: 2vw; padding: 1.8vh 0; border-bottom: 1px solid rgba(138,155,168,0.06);`}
          >
            <time style="font-family: var(--font-mono); font-size: clamp(0.6rem, 0.65vw, 0.7rem); color: var(--color-muted-silver); opacity: 0.4;">
              {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: '2-digit' })}
            </time>

            <h3
              class="group-hover:text-[var(--color-sacred-gold)] transition-colors"
              style="font-family: var(--font-body); font-size: clamp(0.9rem, 1vw, 1.1rem); font-weight: 400; line-height: 1.4; color: var(--color-parchment);"
            >
              {post.data.title}
            </h3>

            {post.data.tags.length > 0 && (
              <span
                class="hidden sm:inline"
                style="font-family: var(--font-mono); font-size: clamp(0.5rem, 0.55vw, 0.6rem); color: var(--color-muted-silver); opacity: 0.25; text-align: right;"
              >
                {post.data.tags[0]}
              </span>
            )}
          </a>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
