---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCardByNumeral } from '../lib/tarot';
import { getCardPalette } from '../lib/cardColors';
import SiteHeader from '../components/SiteHeader.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const cardPosts = allPosts.filter((p) => p.data.card);

const sortedCardPosts = [...cardPosts].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const totalEntries = sortedCardPosts.length;
const yearsActive =
  sortedCardPosts.length > 0
    ? (() => {
        const years = sortedCardPosts.map((p) => p.data.date.getFullYear());
        const lo = Math.min(...years);
        const hi = Math.max(...years);
        return lo === hi ? `${lo}` : `${lo}–${hi}`;
      })()
    : '';
---

<BaseLayout
  title="The Shesh Travelogue"
  description="Field-movement entries. Each post sits at a tarot position on the spiral. The most recent reading appears first."
>
  <SiteHeader />

  <main class="min-h-[100dvh]">
    {/* Hero — left-aligned, asymmetric, intentional whitespace */}
    <section class="px-6 pt-[clamp(6rem,11vw,9rem)] pb-[clamp(3rem,6vw,5rem)] sm:px-10 lg:px-16">
      <div class="mx-auto grid max-w-[1280px] grid-cols-12 gap-x-6">
        <div class="col-span-12 mb-8 sm:col-span-3 sm:mb-0 lg:col-span-2">
          <div class="grid gap-1.5">
            <span
              class="text-[0.62rem] uppercase"
              style="font-family: var(--font-mono); letter-spacing: 0.32em; color: var(--color-sacred-gold); opacity: 0.65;"
            >Almanac</span>
            <span
              class="text-[0.7rem] tabular-nums"
              style="font-family: var(--font-mono); color: var(--color-muted-silver); opacity: 0.42;"
            >{totalEntries} entries · {yearsActive}</span>
          </div>
        </div>

        <div class="col-span-12 sm:col-span-9 lg:col-span-9 lg:col-start-4">
          <h1
            class="text-[clamp(2.4rem,5.4vw,4.4rem)] leading-[0.96] tracking-tight text-[var(--color-parchment)]"
            style="font-family: var(--font-display); font-weight: 600;"
          >
            The Shesh<br />
            <em class="not-italic" style="color: var(--color-sacred-gold);">Travelogue</em>.
          </h1>
          <p
            class="mt-8 max-w-[52ch] text-base leading-relaxed sm:text-[1.05rem]"
            style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.78;"
          >
            Field-movement entries. The body went here, the field changed, the tarot card names the position. Each entry sits at a node on the spiral.
          </p>
        </div>
      </div>
    </section>

    {/* Timeline — vertical chronological log */}
    {sortedCardPosts.length > 0 && (
      <section
        id="travelogue-sequence"
        class="px-6 pb-[clamp(6rem,12vw,11rem)] sm:px-10 lg:px-16"
      >
        <div class="mx-auto max-w-[1280px]">
          <div class="grid grid-cols-12 gap-6 border-t border-[rgba(197,160,23,0.18)] pt-4">
            <div class="col-span-12 sm:col-span-3 lg:col-span-2">
              <span
                class="text-[0.62rem] uppercase"
                style="font-family: var(--font-mono); letter-spacing: 0.32em; color: var(--color-sacred-gold); opacity: 0.65;"
              >Field Sequence</span>
            </div>
            <div class="col-span-12 sm:col-span-9 lg:col-span-9 lg:col-start-4">
              <p
                class="max-w-[52ch] text-[0.92rem] leading-relaxed"
                style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.62;"
              >
                Each entry is dated and tarot-anchored. The card numeral marks the position; the date marks when the body was there. Newest first.
              </p>
            </div>
          </div>

          <ol class="mt-10 grid gap-0">
            {sortedCardPosts.map((post) => {
              const card = post.data.card ? getCardByNumeral(post.data.card) : null;
              const palette = post.data.card ? getCardPalette(post.data.card) : null;
              const accent = palette?.accentColor || '#C5A017';
              const day = post.data.date.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
              });
              const year = post.data.date.getFullYear();
              return (
                <li>
                  <a
                    href={`/posts/${post.id}`}
                    class="group grid grid-cols-12 gap-x-6 border-t border-[rgba(138,155,168,0.1)] py-7 transition-transform duration-500 hover:translate-x-1.5 sm:py-8"
                    style={`--row-accent: ${accent};`}
                  >
                    {/* Date stamp */}
                    <div class="col-span-12 mb-3 flex items-baseline gap-3 sm:col-span-3 sm:mb-0 sm:flex-col sm:items-start sm:gap-1.5 lg:col-span-2">
                      <time
                        class="text-[0.7rem] tabular-nums uppercase"
                        style="font-family: var(--font-mono); letter-spacing: 0.16em; color: var(--color-muted-silver); opacity: 0.55;"
                      >{day} <span class="opacity-60">{year}</span></time>
                      <span
                        class="text-[2.2rem] font-light leading-none tracking-tight tabular-nums sm:text-[2.6rem]"
                        style={`font-family: var(--font-display); color: ${accent}; opacity: 0.62; transition: opacity 0.3s ease;`}
                      >{post.data.card}</span>
                    </div>

                    {/* Title + meta */}
                    <div class="col-span-12 sm:col-span-9 lg:col-span-9 lg:col-start-4">
                      <h3
                        class="text-[clamp(1.2rem,1.95vw,1.55rem)] leading-[1.18] text-[var(--color-parchment)] transition-colors duration-300"
                        style="font-family: var(--font-display); font-weight: 500;"
                      >{post.data.title}</h3>

                      <div
                        class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.66rem] uppercase"
                        style="font-family: var(--font-mono); letter-spacing: 0.18em; color: var(--color-muted-silver); opacity: 0.5;"
                      >
                        {card && <span>{card.thothName}</span>}
                        {card && (
                          <span style={`color: ${accent}; opacity: 0.6;`}>·</span>
                        )}
                        {card && <span>{card.heroPhase}</span>}
                        {post.data.location && (
                          <>
                            <span style={`color: ${accent}; opacity: 0.6;`}>·</span>
                            <span>{post.data.location}</span>
                          </>
                        )}
                      </div>

                      {post.data.excerpt && (
                        <p
                          class="mt-4 max-w-[60ch] text-[0.92rem] leading-relaxed"
                          style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.65;"
                        >{post.data.excerpt}</p>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      </section>
    )}
  </main>

  <style>
    a.group:hover h3 {
      color: var(--color-sacred-gold);
    }
    a.group:hover [style*='--row-accent'] {
      opacity: 1;
    }
  </style>
</BaseLayout>
