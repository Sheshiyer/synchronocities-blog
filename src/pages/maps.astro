---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  buildArchiveDataset,
  getArchivePreset,
  getPinnedArchiveRecords,
} from '../lib/archive';
import SiteHeader from '../components/SiteHeader.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const archiveDataset = buildArchiveDataset(allPosts);
const mapRecords = getArchivePreset(archiveDataset.records, 'hubs');
const pinnedRecords = getPinnedArchiveRecords(archiveDataset.records, 3);
const topTopics = archiveDataset.topicFacets.slice(0, 14);
const topConcepts = archiveDataset.conceptFacets.slice(0, 24);

function formatKind(record: (typeof archiveDataset.records)[number]) {
  if (record.card) return `Travel Arc ${record.card}`;
  if (record.entryKind === 'hub') return 'Hub';
  if (record.entryKind === 'reference') return 'Reference';
  switch (record.articleMode) {
    case 'signal-essay':
      return 'Signal Essay';
    case 'field-note':
      return 'Field Note';
    case 'research-essay':
      return 'Research Essay';
    default:
      return 'Essay';
  }
}
---

<BaseLayout
  title="Maps & Indexes"
  description="Hub entries, pinned readings, and concept clusters. Navigate by framework family or system index."
>
  <SiteHeader />

  <main class="min-h-[100dvh]">
    {/* Hero — three-line declarative claim, indented from left */}
    <section class="px-6 pt-[clamp(6rem,11vw,9rem)] pb-[clamp(3rem,6vw,5rem)] sm:px-10 lg:px-16">
      <div class="mx-auto max-w-[1280px]">
        <div class="grid grid-cols-12 gap-x-6">
          <div class="col-span-12 hidden lg:col-span-3 lg:block" />
          <div class="col-span-12 lg:col-span-9">
            <span
              class="mb-7 block text-[0.62rem] uppercase"
              style="font-family: var(--font-mono); letter-spacing: 0.32em; color: var(--color-sacred-gold); opacity: 0.7;"
            >Atlas · Hubs · Indexes</span>
            <h1
              class="max-w-[18ch] text-[clamp(2rem,3.8vw,3.1rem)] leading-[1.04] tracking-tight text-[var(--color-parchment)]"
              style="font-family: var(--font-display); font-weight: 500;"
            >
              Concept clusters.<br />
              Framework families.<br />
              <em class="not-italic" style="color: var(--color-sacred-gold);">Where threads converge.</em>
            </h1>
            <p
              class="mt-8 max-w-[58ch] text-base leading-relaxed sm:text-[1.04rem]"
              style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.78;"
            >
              Hub entries gather an inquiry's threads in one place. Bioelectric systems. The consciousness stack. The Lorenz–Kundli mapping. The sonic-geometric program. Each map names a region; each region routes into the essays that develop it.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Pinned — single-row featured (1 large + 2 medium asymmetric, no equal cards) */}
    {pinnedRecords.length > 0 && (
      <section class="px-6 pb-[clamp(3rem,6vw,5rem)] sm:px-10 lg:px-16">
        <div class="mx-auto max-w-[1280px]">
          <div class="mb-6 flex items-baseline justify-between border-b border-[rgba(197,160,23,0.22)] pb-3">
            <span
              class="text-[0.62rem] uppercase"
              style="font-family: var(--font-mono); letter-spacing: 0.32em; color: var(--color-sacred-gold); opacity: 0.72;"
            >Pinned</span>
            <span
              class="text-[0.62rem] tabular-nums uppercase"
              style="font-family: var(--font-mono); letter-spacing: 0.18em; color: var(--color-muted-silver); opacity: 0.42;"
            >Reader's compass</span>
          </div>

          <div class="grid grid-cols-12 gap-6 lg:gap-10">
            {pinnedRecords.map((record, idx) => (
              <a
                href={`/posts/${record.slug}`}
                class={
                  idx === 0
                    ? 'group col-span-12 grid gap-4 lg:col-span-7'
                    : 'group col-span-12 grid gap-3 sm:col-span-6 lg:col-span-5'
                }
              >
                <div
                  class="text-[0.62rem] uppercase"
                  style="font-family: var(--font-mono); letter-spacing: 0.22em; color: var(--color-sacred-gold); opacity: 0.7;"
                >P{String(idx + 1).padStart(2, '0')} · {formatKind(record)}</div>
                <h3
                  class={
                    idx === 0
                      ? 'max-w-[18ch] text-[clamp(1.6rem,2.5vw,2.1rem)] leading-[1.08] text-[var(--color-parchment)] transition-colors duration-300 group-hover:text-[var(--color-sacred-gold)]'
                      : 'max-w-[22ch] text-[clamp(1.15rem,1.8vw,1.5rem)] leading-[1.12] text-[var(--color-parchment)] transition-colors duration-300 group-hover:text-[var(--color-sacred-gold)]'
                  }
                  style="font-family: var(--font-display); font-weight: 500;"
                >{record.title}</h3>
                {record.excerpt && (
                  <p
                    class="max-w-[55ch] text-[0.92rem] leading-relaxed"
                    style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.7;"
                  >{record.excerpt}</p>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Concepts facet — richer semantic phrases, deep-link into /research */}
    {topConcepts.length > 0 && (
      <section class="px-6 pb-[clamp(3rem,6vw,5rem)] sm:px-10 lg:px-16">
        <div class="mx-auto max-w-[1280px]">
          <div class="mb-6 flex items-baseline justify-between border-b border-[rgba(16,181,167,0.22)] pb-3">
            <span
              class="text-[0.62rem] uppercase"
              style="font-family: var(--font-mono); letter-spacing: 0.32em; color: var(--color-coherence-emerald); opacity: 0.78;"
            >Concepts</span>
            <span
              class="text-[0.62rem] tabular-nums uppercase"
              style="font-family: var(--font-mono); letter-spacing: 0.18em; color: var(--color-muted-silver); opacity: 0.42;"
            >{topConcepts.length} of {archiveDataset.conceptFacets.length}</span>
          </div>
          <p
            class="mb-5 max-w-[58ch] text-[0.9rem] leading-relaxed"
            style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.62;"
          >
            Canonical phrases the corpus develops. Click any concept to open the Research library filtered to entries that cite it.
          </p>
          <div class="flex flex-wrap items-baseline gap-x-5 gap-y-3">
            {topConcepts.map(({ concept, count }) => (
              <a
                href={`/research?q=${encodeURIComponent(concept)}`}
                class="group flex items-baseline gap-1.5 transition-colors"
              >
                <span
                  class="text-[0.95rem] text-[var(--color-muted-silver)] transition-colors group-hover:text-[var(--color-coherence-emerald)]"
                  style="font-family: var(--font-display);"
                >{concept}</span>
                <span
                  class="text-[0.62rem] tabular-nums"
                  style="font-family: var(--font-mono); color: var(--color-muted-silver); opacity: 0.45;"
                >{String(count).padStart(2, '0')}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Topic register — inline horizontal list, not chips on a card */}
    {topTopics.length > 0 && (
      <section class="px-6 pb-[clamp(3rem,6vw,5rem)] sm:px-10 lg:px-16">
        <div class="mx-auto max-w-[1280px]">
          <div class="mb-6 flex items-baseline justify-between border-b border-[rgba(138,155,168,0.18)] pb-3">
            <span
              class="text-[0.62rem] uppercase"
              style="font-family: var(--font-mono); letter-spacing: 0.32em; color: var(--color-muted-silver); opacity: 0.62;"
            >Topic Register</span>
            <span
              class="text-[0.62rem] tabular-nums uppercase"
              style="font-family: var(--font-mono); letter-spacing: 0.18em; color: var(--color-muted-silver); opacity: 0.42;"
            >Frequency-weighted</span>
          </div>
          <div class="flex flex-wrap items-baseline gap-x-6 gap-y-3">
            {topTopics.map(({ topic, count }) => (
              <a
                href={`/journeys?topic=${encodeURIComponent(topic)}`}
                class="group flex items-baseline gap-1.5 transition-colors"
              >
                <span
                  class="text-[0.95rem] text-[var(--color-muted-silver)] transition-colors group-hover:text-[var(--color-sacred-gold)]"
                  style="font-family: var(--font-display);"
                >{topic}</span>
                <span
                  class="text-[0.62rem] tabular-nums"
                  style="font-family: var(--font-mono); color: var(--color-muted-silver); opacity: 0.45;"
                >{String(count).padStart(2, '0')}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Hub register — encyclopedic entries with concept rails */}
    <section class="px-6 pb-[clamp(6rem,12vw,11rem)] sm:px-10 lg:px-16">
      <div class="mx-auto max-w-[1280px]">
        <div class="mb-6 flex items-baseline justify-between border-b border-[rgba(16,181,167,0.22)] pb-3">
          <span
            class="text-[0.62rem] uppercase"
            style="font-family: var(--font-mono); letter-spacing: 0.32em; color: var(--color-coherence-emerald); opacity: 0.78;"
          >Hub Register</span>
          <span
            class="text-[0.62rem] tabular-nums uppercase"
            style="font-family: var(--font-mono); letter-spacing: 0.18em; color: var(--color-muted-silver); opacity: 0.42;"
          >{String(mapRecords.length).padStart(2, '0')} hubs</span>
        </div>

        <ul class="grid gap-0">
          {mapRecords.map((record, idx) => (
            <li>
              <a
                href={`/posts/${record.slug}`}
                class="group grid grid-cols-12 gap-x-6 gap-y-3 border-t border-[rgba(138,155,168,0.1)] py-8 transition-transform duration-500 hover:translate-x-1.5 sm:py-9"
              >
                {/* H-code rail */}
                <div class="col-span-12 sm:col-span-2 lg:col-span-2">
                  <div class="grid gap-1">
                    <span
                      class="text-[1.55rem] tabular-nums leading-none"
                      style="font-family: var(--font-display); font-weight: 500; color: var(--color-coherence-emerald); opacity: 0.65;"
                    >H{String(idx + 1).padStart(2, '0')}</span>
                    <span
                      class="text-[0.6rem] uppercase"
                      style="font-family: var(--font-mono); letter-spacing: 0.22em; color: var(--color-muted-silver); opacity: 0.45;"
                    >{formatKind(record)}</span>
                  </div>
                </div>

                {/* Title + prose */}
                <div class="col-span-12 sm:col-span-7 lg:col-span-7">
                  <h3
                    class="text-[clamp(1.2rem,2vw,1.65rem)] leading-[1.16] text-[var(--color-parchment)] transition-colors duration-300 group-hover:text-[var(--color-sacred-gold)]"
                    style="font-family: var(--font-display); font-weight: 500;"
                  >{record.title}</h3>
                  {record.excerpt && (
                    <p
                      class="mt-3 max-w-[60ch] text-[0.92rem] leading-relaxed"
                      style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.7;"
                    >{record.excerpt}</p>
                  )}
                </div>

                {/* Concept rail */}
                <div class="col-span-12 sm:col-span-3 lg:col-span-3">
                  {record.concepts.length > 0 && (
                    <ul class="grid gap-1.5">
                      {record.concepts.slice(0, 5).map((concept) => (
                        <li
                          class="text-[0.62rem] uppercase"
                          style="font-family: var(--font-mono); letter-spacing: 0.16em; color: var(--color-muted-silver); opacity: 0.55;"
                        >{concept}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Search at bottom — minimal command-line feel, not a generic form panel */}
    <section class="px-6 pb-[clamp(8rem,14vw,12rem)] sm:px-10 lg:px-16">
      <div class="mx-auto max-w-[1280px]">
        <div class="mb-5 flex items-baseline justify-between border-b border-[rgba(138,155,168,0.18)] pb-3">
          <span
            class="text-[0.62rem] uppercase"
            style="font-family: var(--font-mono); letter-spacing: 0.32em; color: var(--color-muted-silver); opacity: 0.6;"
          >Find</span>
          <span
            class="text-[0.62rem] uppercase"
            style="font-family: var(--font-mono); letter-spacing: 0.18em; color: var(--color-muted-silver); opacity: 0.42;"
          >Query the archive</span>
        </div>
        <form action="/journeys" method="get" class="grid gap-4">
          <label class="grid gap-2">
            <span
              class="text-[0.62rem] uppercase"
              style="font-family: var(--font-mono); letter-spacing: 0.22em; color: var(--color-muted-silver); opacity: 0.55;"
            >Query</span>
            <div class="flex items-center gap-2 border-b border-[rgba(138,155,168,0.22)] pb-2 transition-colors focus-within:border-[var(--color-sacred-gold)]">
              <span
                class="text-[0.9rem] tabular-nums"
                style="font-family: var(--font-mono); color: var(--color-coherence-emerald); opacity: 0.62;"
              >&gt;</span>
              <input
                type="search"
                name="q"
                placeholder="titles, concepts, tags, clusters"
                class="w-full bg-transparent text-base text-[var(--color-parchment)] placeholder:text-[var(--color-muted-silver)]/40 focus:outline-none"
                style="font-family: var(--font-mono);"
              />
            </div>
          </label>
          <div class="flex flex-wrap gap-x-5 gap-y-2">
            <button
              type="submit"
              class="text-[0.7rem] uppercase transition-colors hover:text-[var(--color-sacred-gold)]"
              style="font-family: var(--font-mono); letter-spacing: 0.22em; color: var(--color-sacred-gold);"
            >Run search →</button>
            <a
              href="/journeys?preset=foundational"
              class="text-[0.7rem] uppercase transition-colors hover:text-[var(--color-sacred-gold)]"
              style="font-family: var(--font-mono); letter-spacing: 0.22em; color: var(--color-muted-silver); opacity: 0.7;"
            >Foundational only</a>
            <a
              href="/journeys"
              class="text-[0.7rem] uppercase transition-colors hover:text-[var(--color-sacred-gold)]"
              style="font-family: var(--font-mono); letter-spacing: 0.22em; color: var(--color-muted-silver); opacity: 0.7;"
            >Open archive</a>
          </div>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
