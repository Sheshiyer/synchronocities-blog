---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveSearchGateway from '../components/ArchiveSearchGateway.astro';
import { getCollection } from 'astro:content';
import { buildArchiveDataset, getArchivePreset, getPinnedArchiveRecords } from '../lib/archive';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const archiveDataset = buildArchiveDataset(allPosts);
const mapRecords = getArchivePreset(archiveDataset.records, 'hubs');
const pinnedRecords = getPinnedArchiveRecords(archiveDataset.records, 4);
const topTopics = archiveDataset.topicFacets.slice(0, 12);

function formatKind(record: (typeof archiveDataset.records)[number]) {
  if (record.card) {
    return `Travel Arc ${record.card}`;
  }

  if (record.entryKind === 'hub') {
    return 'Hub';
  }

  if (record.entryKind === 'reference') {
    return 'Reference';
  }

  switch (record.articleMode) {
    case 'signal-essay':
      return 'Signal Essay';
    case 'field-note':
      return 'Field Note';
    case 'research-essay':
      return 'Research Essay';
    default:
      return 'Essay';
  }
}
---

<BaseLayout title="Maps & Indexes" description="Hub entries, pinned readings, and concept clusters. Navigate by framework family or system index.">
  <header
    class="fixed top-0 left-0 right-0 z-20 flex flex-wrap items-center justify-between gap-3 backdrop-blur-md"
    style="padding: 2vh 4vw; background: rgba(7,11,29,0.85);"
  >
    <a href="/" class="inline-flex items-center gap-3">
      <model-viewer
        src="/models/sigil-foil-hero.glb"
        alt="Synchronocities sigil"
        auto-rotate
        rotation-per-second="18deg"
        exposure="1.2"
        shadow-intensity="0"
        disable-zoom
        interaction-prompt="none"
        camera-orbit="0deg 75deg 2.4m"
        poster="/models/sigil-foil-preview.png"
        loading="lazy"
        style="width: 48px; height: 48px; --poster-color: transparent; background: transparent; pointer-events: none;"
      ></model-viewer>
      <span
        style="font-family: var(--font-display); font-size: clamp(0.85rem, 1vw, 1.1rem); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-sacred-gold);"
      >
        Synchronocities
      </span>
    </a>
    <nav class="flex max-w-[58vw] items-center justify-end gap-3 overflow-x-auto whitespace-nowrap pl-3 sm:max-w-none sm:gap-5 sm:pl-0" style="font-family: var(--font-mono); font-size: clamp(0.63rem, 0.75vw, 0.8rem); scrollbar-width: none;">
      <a href="/" class="transition-colors hover:text-[var(--color-sacred-gold)]" style="color: var(--color-muted-silver);">Depth</a>
      <a href="/journeys" class="transition-colors hover:text-[var(--color-sacred-gold)]" style="color: var(--color-muted-silver);">Journeys</a>
      <a href="/research" class="transition-colors hover:text-[var(--color-sacred-gold)]" style="color: var(--color-muted-silver);">Research</a>
      <a href="/maps" style="color: var(--color-sacred-gold);">Maps</a>
    </nav>
  </header>

  <main style="padding: 14vh 6vw 10vh;">
    <section style="display: grid; gap: 1.5rem; max-width: 64rem; margin-bottom: 4rem;">
      <span style="font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-sacred-gold); opacity: 0.78;">
        Maps & Indexes
      </span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.35rem, 4.7vw, 4.7rem); line-height: 1.02; color: var(--color-parchment);">
        Concept clusters. Framework families. System indexes.
      </h1>
      <p style="font-family: var(--font-body); font-size: clamp(0.98rem, 1.05vw, 1.14rem); line-height: 1.75; color: var(--color-muted-silver); opacity: 0.8; max-width: 46rem;">
        Hub entries that gather an inquiry's threads in one place. Each map names a concept cluster — bioelectric systems, the consciousness stack, the Lorenz-Kundli mapping, the sonic-geometric program — and routes into the essays that develop it.
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
        <a href="/journeys" style="font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 0.75rem 0.95rem; border-radius: 999px; border: 1px solid rgba(197,160,23,0.24); background: rgba(197,160,23,0.08); color: var(--color-sacred-gold);">
          Open Full Archive
        </a>
        <a href="/research" style="font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 0.75rem 0.95rem; border-radius: 999px; border: 1px solid rgba(16,181,167,0.2); background: rgba(16,181,167,0.08); color: var(--color-coherence-emerald);">
          Browse Research
        </a>
      </div>
    </section>

    <section style="display: grid; gap: 1.25rem; max-width: 64rem; margin-bottom: 4rem;">
      <ArchiveSearchGateway
        title="Search the archive"
        description="Search across titles, concepts, tags, and clusters. Filter by foundational, pilot, hub, signal-essay, field-note."
      />
    </section>

    {pinnedRecords.length > 0 && (
      <section style="margin-bottom: 4rem;">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
          <span style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-sacred-gold); opacity: 0.72;">
            Pinned Entries
          </span>
          <div style="flex: 1; height: 1px; background: linear-gradient(90deg, rgba(197,160,23,0.2), transparent);" />
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
          {pinnedRecords.map((record) => (
            <a href={`/posts/${record.slug}`} style="display: grid; gap: 0.8rem; padding: 1.15rem; border-radius: 1rem; border: 1px solid rgba(197,160,23,0.16); background: linear-gradient(180deg, rgba(14,20,40,0.76), rgba(7,11,29,0.96));">
              <div style="display: flex; justify-content: space-between; gap: 0.75rem; align-items: baseline;">
                <span style="font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-sacred-gold); opacity: 0.8;">
                  {formatKind(record)}
                </span>
                <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-muted-silver); opacity: 0.5;">
                  {record.readTimeMinutes ? `${record.readTimeMinutes} min` : ''}
                </span>
              </div>

              <h2 style="font-family: var(--font-display); font-size: 1.28rem; line-height: 1.12; color: var(--color-parchment);">
                {record.title}
              </h2>

              {record.excerpt && (
                <p style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.82; max-width: none;">
                  {record.excerpt}
                </p>
              )}

              <div style="display: flex; flex-wrap: wrap; gap: 0.45rem;">
                {(record.concepts.length > 0 ? record.concepts : record.tags).slice(0, 3).map((topic) => (
                  <span style="font-family: var(--font-mono); font-size: 0.68rem; padding: 0.4rem 0.55rem; border-radius: 999px; border: 1px solid rgba(138,155,168,0.14); color: var(--color-muted-silver); opacity: 0.72;">
                    {topic}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {topTopics.length > 0 && (
      <section style="margin-bottom: 4rem;">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
          <span style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-coherence-emerald); opacity: 0.72;">
            Top Topics
          </span>
          <div style="flex: 1; height: 1px; background: linear-gradient(90deg, rgba(16,181,167,0.2), transparent);" />
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 0.65rem;">
          {topTopics.map(({ topic, count }) => (
            <a
              href={`/journeys?topic=${encodeURIComponent(topic)}`}
              style="font-family: var(--font-mono); font-size: 0.72rem; padding: 0.65rem 0.82rem; border-radius: 999px; border: 1px solid rgba(16,181,167,0.18); background: rgba(16,181,167,0.08); color: var(--color-coherence-emerald);"
            >
              {topic}
              <span style="margin-left: 0.45rem; opacity: 0.6;">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
      {mapRecords.map((record) => (
          <a href={`/posts/${record.slug}`} style="display: grid; gap: 0.85rem; padding: 1.2rem; border-radius: 1rem; border: 1px solid rgba(138,155,168,0.12); background: linear-gradient(180deg, rgba(14,20,40,0.72), rgba(7,11,29,0.95));">
            <div style="display: flex; justify-content: space-between; gap: 0.75rem; align-items: baseline;">
              <span style="font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-coherence-emerald); opacity: 0.78;">
                {formatKind(record)}
              </span>
              <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-muted-silver); opacity: 0.5;">
                {record.series ?? ''}
              </span>
          </div>

          <h2 style="font-family: var(--font-display); font-size: 1.32rem; line-height: 1.1; color: var(--color-parchment);">
            {record.title}
          </h2>

          {record.excerpt && (
            <p style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.82; max-width: none;">
              {record.excerpt}
            </p>
          )}

          <div style="display: flex; flex-wrap: wrap; gap: 0.45rem;">
            {record.concepts.slice(0, 4).map((concept) => (
              <span style="font-family: var(--font-mono); font-size: 0.68rem; padding: 0.42rem 0.58rem; border-radius: 999px; border: 1px solid rgba(138,155,168,0.12); color: var(--color-muted-silver); opacity: 0.74;">
                {concept}
              </span>
            ))}
          </div>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
