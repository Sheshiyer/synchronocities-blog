---
import BaseLayout from '../layouts/BaseLayout.astro';
import DepthGallery from '../components/DepthGallery';
import { getCollection } from 'astro:content';
import { isDepthSpiralEligiblePost, normalizePostEntry } from '../lib/postMetadata';

const allPosts = await getCollection('posts', ({ data }) => !data.draft && !data.hidden);

// Deterministic shuffle: hash each slug to produce a stable non-linear order.
// Changes only when posts are added/removed, not on every build.
function hashCode(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) {
    h = ((h << 5) - h + s.charCodeAt(i)) | 0;
  }
  return h;
}

// Seed the shuffle from the total post count so adding a post reshuffles everything
const seed = allPosts.length;
const shuffledPosts = [...allPosts].sort((a, b) => {
  const ha = hashCode(a.id + seed) >>> 0;
  const hb = hashCode(b.id + seed) >>> 0;
  return ha - hb;
});

const postsForGallery = shuffledPosts
  .map((post) => normalizePostEntry(post))
  .filter((normalized) => isDepthSpiralEligiblePost(normalized))
  .map((normalized) => ({
    slug: normalized.slug,
    title: normalized.title,
    card: normalized.card,
    date: normalized.date.toISOString(),
    excerpt: normalized.excerpt,
    featuredImage: normalized.heroImage,
  }));
---

<BaseLayout title="Synchronocities">
  <header class="fixed left-1/2 top-3 z-20 flex w-[min(calc(100%-1.5rem),84rem)] -translate-x-1/2 items-center justify-between gap-3 rounded-full border border-[rgba(138,155,168,0.16)] bg-[rgba(7,11,29,0.56)] px-4 py-2 shadow-[0_18px_50px_rgba(0,0,0,0.24)] backdrop-blur-md sm:top-5 sm:w-[min(calc(100%-3rem),84rem)] sm:gap-4 sm:px-6 lg:top-6 lg:w-[min(calc(100%-4rem),84rem)]">
    <a href="/" class="flex items-center gap-2.5 sm:gap-3.5">
      <span class="block h-10 w-10 shrink-0 sm:h-12 sm:w-12">
        <model-viewer
          src="/models/sigil-foil-hero.glb"
          alt="Synchronocities sigil"
          auto-rotate
          rotation-per-second="18deg"
          exposure="1.2"
          shadow-intensity="0"
          disable-zoom
          interaction-prompt="none"
          camera-orbit="0deg 75deg 2.4m"
          poster="/models/sigil-foil-preview.png"
          loading="lazy"
          style="width: 100%; height: 100%; --poster-color: transparent; background: transparent; pointer-events: none;"
        ></model-viewer>
      </span>
      <span
        class="text-sm font-semibold tracking-[0.08em] uppercase sm:text-base"
        style="font-family: var(--font-display); color: var(--color-sacred-gold);"
      >
        Synchronocities
      </span>
    </a>
    <nav class="flex max-w-[60vw] items-center justify-end gap-3 overflow-x-auto whitespace-nowrap pl-3 text-[0.63rem] sm:max-w-none sm:gap-5 sm:pl-0 sm:text-sm" style="font-family: var(--font-mono); scrollbar-width: none;">
      <a href="/" class="text-[var(--color-parchment)] hover:text-[var(--color-sacred-gold)] transition-colors">
        Depth
      </a>
      <a href="/journeys" class="text-[var(--color-muted-silver)] hover:text-[var(--color-sacred-gold)] transition-colors">
        Journeys
      </a>
      <a href="/research" class="text-[var(--color-muted-silver)] hover:text-[var(--color-sacred-gold)] transition-colors">
        Research
      </a>
      <a href="/maps" class="text-[var(--color-muted-silver)] hover:text-[var(--color-sacred-gold)] transition-colors">
        Maps
      </a>
    </nav>
  </header>

  <DepthGallery client:only="react" posts={postsForGallery} />
</BaseLayout>
