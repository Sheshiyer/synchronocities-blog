---
import BaseLayout from '../layouts/BaseLayout.astro';
import DepthGallery from '../components/DepthGallery';
import { getCollection } from 'astro:content';
import { buildArchiveDataset, findArchiveRecord } from '../lib/archive';
import { normalizePostEntry } from '../lib/postMetadata';

const allPosts = await getCollection('posts', ({ data }) => !data.draft && !data.hidden);
const archiveDataset = buildArchiveDataset(allPosts);

// Sort by date chronologically (journey order)
const sortedPosts = [...allPosts].sort((a, b) => {
  return a.data.date.getTime() - b.data.date.getTime();
});

const postsForGallery = sortedPosts.map((post) => {
  const normalized = normalizePostEntry(post);

  return {
    slug: normalized.slug,
    title: normalized.title,
    card: normalized.card,
    date: normalized.date.toISOString(),
    excerpt: normalized.excerpt,
    featuredImage: normalized.heroImage,
  };
});

const pilotEntry = findArchiveRecord(archiveDataset.records, 'the-downstream-mind');
const mapEntry = archiveDataset.records.find((record) => record.entryKind === 'hub' || record.entryKind === 'reference');
const foundationalEntry = archiveDataset.records.find((record) => record.foundational && !record.card);
---

<BaseLayout title="Synchronocities">
  <!-- Header overlay -->
  <header class="fixed top-0 left-0 right-0 z-20 flex flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-8 sm:py-6">
    <a href="/" class="flex items-center gap-3">
      <span
        class="text-lg font-semibold tracking-[0.08em] uppercase"
        style="font-family: var(--font-display); color: var(--color-sacred-gold);"
      >
        Synchronocities
      </span>
    </a>
    <nav class="flex max-w-[58vw] items-center justify-end gap-3 overflow-x-auto whitespace-nowrap pl-3 text-[0.63rem] sm:max-w-none sm:gap-6 sm:pl-0 sm:text-sm" style="font-family: var(--font-mono); scrollbar-width: none;">
      <a href="/" class="text-[var(--color-muted-silver)] hover:text-[var(--color-sacred-gold)] transition-colors">
        Depth
      </a>
      <a href="/journeys" class="text-[var(--color-muted-silver)] hover:text-[var(--color-sacred-gold)] transition-colors">
        Journeys
      </a>
      <a href="/research" class="text-[var(--color-muted-silver)] hover:text-[var(--color-sacred-gold)] transition-colors">
        Research
      </a>
      <a href="/maps" class="text-[var(--color-muted-silver)] hover:text-[var(--color-sacred-gold)] transition-colors">
        Maps
      </a>
    </nav>
  </header>

  <main class="relative min-h-screen overflow-hidden">
    <div class="absolute inset-0 z-[1] pointer-events-none bg-[linear-gradient(90deg,rgba(7,11,29,0.92)_0%,rgba(7,11,29,0.74)_36%,rgba(7,11,29,0.28)_62%,rgba(7,11,29,0.04)_100%)]"></div>

    <section class="relative z-10 min-h-screen px-4 pt-24 pb-8 sm:px-8 md:px-12 md:pt-28 md:pb-10 xl:pt-32">
      <div class="mx-auto grid min-h-[calc(100vh-7rem)] max-w-[84rem] gap-8 pointer-events-none lg:grid-cols-[minmax(0,1fr)_minmax(19.5rem,23rem)] lg:items-end lg:gap-6 xl:grid-cols-[minmax(0,1.05fr)_minmax(24rem,31rem)] xl:gap-10">
        <div class="pointer-events-auto flex max-w-[38rem] flex-col justify-end lg:max-w-[32rem] xl:max-w-[38rem] xl:pb-4">
          <div class="rounded-[1.4rem] border border-[rgba(138,155,168,0.14)] bg-[linear-gradient(180deg,rgba(7,11,29,0.78),rgba(7,11,29,0.9))] p-5 shadow-[0_24px_80px_rgba(0,0,0,0.28)] backdrop-blur-md sm:p-6 xl:p-7">
            <div class="inline-flex flex-wrap items-center gap-3 rounded-full border border-[rgba(197,160,23,0.2)] bg-[rgba(7,11,29,0.42)] px-4 py-2">
              <span class="text-[0.68rem] uppercase tracking-[0.22em] text-[var(--color-sacred-gold)]" style="font-family: var(--font-mono);">
                Spiral Entry
              </span>
              <span class="text-[0.78rem] text-[var(--color-muted-silver)] opacity-70" style="font-family: var(--font-body);">
                Visual depth gallery plus explicit archive routes
              </span>
            </div>

            <h1 class="mt-5 max-w-[10ch] text-[clamp(1.9rem,11vw,2.75rem)] leading-[0.94] text-[var(--color-parchment)] sm:max-w-[8.5ch] sm:text-[clamp(2.05rem,10vw,3.2rem)] md:text-[clamp(2.2rem,7vw,3.6rem)] xl:text-[clamp(2.35rem,4.9vw,4.15rem)]" style="font-family: var(--font-display);">
              Enter through the spiral, or choose a cleaner path.
            </h1>

            <p class="mt-4 max-w-[32rem] text-[clamp(0.96rem,1.05vw,1.08rem)] leading-7 text-[var(--color-muted-silver)] opacity-82">
              Synchronocities can still be explored as a depth-first visual journey, but new readers should not have to infer the site map from the canvas. Start with story, research, maps, or the pilot essay directly.
            </p>
          </div>
        </div>

        <div class="pointer-events-auto w-full max-w-[40rem] rounded-[1.25rem] border border-[rgba(138,155,168,0.14)] bg-[linear-gradient(180deg,rgba(14,20,40,0.8),rgba(7,11,29,0.96))] p-4 shadow-[0_24px_80px_rgba(0,0,0,0.3)] backdrop-blur-md sm:p-5 xl:ml-auto xl:max-w-none xl:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="max-w-[24rem]">
              <p class="text-[0.68rem] uppercase tracking-[0.22em] text-[var(--color-sacred-gold)] opacity-70" style="font-family: var(--font-mono);">
                Start Here
              </p>
              <h2 class="mt-2 max-w-[18ch] text-[clamp(1.15rem,5vw,1.6rem)] leading-[1.05] text-[var(--color-parchment)] lg:text-[1.45rem] xl:text-[clamp(1.25rem,2.2vw,1.75rem)]" style="font-family: var(--font-display);">
                Pick the entry path that matches how you want to read.
              </h2>
            </div>
            <a href="/journeys" class="rounded-full border border-[rgba(197,160,23,0.22)] bg-[rgba(197,160,23,0.08)] px-4 py-2 text-[0.72rem] uppercase tracking-[0.16em] text-[var(--color-sacred-gold)]" style="font-family: var(--font-mono);">
              Open Archive
            </a>
          </div>

          <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-1 2xl:grid-cols-2">
            <li class="rounded-2xl border border-[rgba(138,155,168,0.1)] bg-[rgba(14,20,40,0.42)] p-4">
              <a href="/journeys#major-arcana" class="block">
                <span class="text-[0.68rem] uppercase tracking-[0.18em] text-[var(--color-sacred-gold)] opacity-75" style="font-family: var(--font-mono);">
                  01 • Travel Arc
                </span>
                <h3 class="mt-2 text-[1.15rem] leading-tight text-[var(--color-parchment)]" style="font-family: var(--font-display);">
                  Walk the Major Arcana journey
                </h3>
                <p class="mt-2 text-sm leading-6 text-[var(--color-muted-silver)] opacity-80">
                  Start with the visual tarot-native spiral and move through the journey cards directly.
                </p>
              </a>
            </li>

            <li class="rounded-2xl border border-[rgba(138,155,168,0.1)] bg-[rgba(14,20,40,0.42)] p-4">
              <a href="/research" class="block">
                <span class="text-[0.68rem] uppercase tracking-[0.18em] text-[var(--color-coherence-emerald)] opacity-80" style="font-family: var(--font-mono);">
                  02 • Research
                </span>
                <h3 class="mt-2 text-[1.15rem] leading-tight text-[var(--color-parchment)]" style="font-family: var(--font-display);">
                  Browse the research library
                </h3>
                <p class="mt-2 text-sm leading-6 text-[var(--color-muted-silver)] opacity-80">
                  {foundationalEntry ? `Start with ${foundationalEntry.title} and the foundational node set.` : 'Open the non-tarot library and work from foundational essays outward.'}
                </p>
              </a>
            </li>

            <li class="rounded-2xl border border-[rgba(138,155,168,0.1)] bg-[rgba(14,20,40,0.42)] p-4">
              <a href={pilotEntry ? `/posts/${pilotEntry.slug}` : '/journeys'} class="block">
                <span class="text-[0.68rem] uppercase tracking-[0.18em] text-[var(--color-sacred-gold)] opacity-75" style="font-family: var(--font-mono);">
                  03 • Pilot Essay
                </span>
                <h3 class="mt-2 text-[1.15rem] leading-tight text-[var(--color-parchment)]" style="font-family: var(--font-display);">
                  Enter through The Downstream Mind
                </h3>
                <p class="mt-2 text-sm leading-6 text-[var(--color-muted-silver)] opacity-80">
                  The seeded pilot cluster now acts as a direct gateway into the broader consciousness-architecture corpus.
                </p>
              </a>
            </li>

            <li class="rounded-2xl border border-[rgba(138,155,168,0.1)] bg-[rgba(14,20,40,0.42)] p-4">
              <a href="/maps" class="block">
                <span class="text-[0.68rem] uppercase tracking-[0.18em] text-[var(--color-muted-silver)] opacity-78" style="font-family: var(--font-mono);">
                  04 • Maps, Search, & Indexes
                </span>
                <h3 class="mt-2 text-[1.15rem] leading-tight text-[var(--color-parchment)]" style="font-family: var(--font-display);">
                  Open the archive atlas
                </h3>
                <p class="mt-2 text-sm leading-6 text-[var(--color-muted-silver)] opacity-80">
                  {mapEntry ? `Use ${mapEntry.title}, pinned entries, and the new atlas search route to orient yourself before dropping into individual essays.` : 'Use hub pages, pinned entries, and the atlas search route to orient yourself before dropping into individual essays.'}
                </p>
              </a>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <DepthGallery client:only="react" posts={postsForGallery} showLabelOverlay={false} />
  </main>
</BaseLayout>
