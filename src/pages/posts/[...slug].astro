---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { getCardByNumeral } from '../../lib/tarot';
import { getCardPalette } from '../../lib/cardColors';
import { getCardExperience } from '../../lib/cardExperience';
import { getArticleExperience, getArticleThemeTokens } from '../../lib/articleExperience';
import { normalizePostEntry } from '../../lib/postMetadata';
import { buildArchiveDataset, getRelatedArchiveRecords, getSeriesCompanions } from '../../lib/archive';
import { getOptimizedCardImage } from '../../lib/cardImageAssets';
import ReadingProgress from '../../components/ReadingProgress';
import ScrollReveal from '../../components/ScrollReveal';
import JourneyProgress from '../../components/JourneyProgress';
import NextPostReveal from '../../components/NextPostReveal';
import PostTOC from '../../components/PostTOC';
import BackToTop from '../../components/BackToTop';
import RelatedPostModules from '../../components/RelatedPostModules.astro';
import NonCardArticleShell from '../../components/non-card/NonCardArticleShell.astro';
import PostFooterNav from '../../components/PostFooterNav.astro';
import SiteHeader from '../../components/SiteHeader.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const normalizedPost = normalizePostEntry(post);
const isCardJourney = normalizedPost.articleMode === 'card-journey';
const card = post.data.card ? getCardByNumeral(post.data.card) : null;
const palette = post.data.card ? getCardPalette(post.data.card) : null;
const experience = post.data.card ? getCardExperience(post.data.card) : null;

// For posts without card palette, use featured_image as hero
const heroImage = palette?.textureSrc || normalizedPost.heroImage || null;
const heroImageAsset = getOptimizedCardImage(heroImage);
const heroImageSizes = '(max-width: 639px) calc(100vw - 2.5rem), (max-width: 1023px) calc(100vw - 4rem), (max-width: 1279px) 20rem, 22rem';

const cardVars = palette ? [
  `--card-bg: ${palette.backgroundColor}`,
  `--card-blob1: ${palette.blob1Color}`,
  `--card-blob2: ${palette.blob2Color}`,
  `--card-accent: ${palette.accentColor}`,
  `--card-gradient-from: ${palette.gradientFrom}`,
  `--card-gradient-via: ${palette.gradientVia}`,
  `--card-gradient-to: ${palette.gradientTo}`,
].join('; ') : '';

const bgGradient = palette
  ? `background: linear-gradient(170deg, ${palette.gradientFrom} 0%, ${palette.gradientVia} 40%, ${palette.gradientTo} 100%);`
  : 'background: var(--color-void-black);';
const dividerColor = palette?.accentColor || 'var(--color-sacred-gold)';
const layout = experience?.layout || 'cosmic-void';
const hasDesktopReadingSidebar = Boolean(experience && layout !== 'hermit-minimal');
const showIntroHero = Boolean(heroImage && layout !== 'hermit-minimal');
const showIntroAside = Boolean(showIntroHero || (experience && layout !== 'hermit-minimal'));
const introGridClass = showIntroHero ? 'has-hero' : 'text-only';

// Sorted posts for navigation
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const archiveDataset = buildArchiveDataset(allPosts);
const relatedArchiveRecords = getRelatedArchiveRecords(archiveDataset, post.id, 4);
const seriesCompanions = getSeriesCompanions(archiveDataset.records, post.id, 3);
const cardOrder: Record<string, number> = {
  '0': 0, 'IX': 9, 'XIV': 14, 'XVI': 16, 'XVII': 17, 'XVIII': 18, 'XX': 20, 'XXI': 21,
};
const sorted = [...allPosts].sort((a, b) => {
  const orderDelta = (cardOrder[a.data.card || ''] ?? 99) - (cardOrder[b.data.card || ''] ?? 99);
  if (orderDelta !== 0) return orderDelta;
  return a.data.date.getTime() - b.data.date.getTime();
});
const currentIndex = sorted.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const nextPost = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
const prevCard = prevPost?.data.card ? getCardByNumeral(prevPost.data.card) : null;
const nextCard = nextPost?.data.card ? getCardByNumeral(nextPost.data.card) : null;
const prevPalette = prevPost?.data.card ? getCardPalette(prevPost.data.card) : null;
const nextPalette = nextPost?.data.card ? getCardPalette(nextPost.data.card) : null;
const prevNormalizedPost = prevPost ? normalizePostEntry(prevPost) : null;
const nextNormalizedPost = nextPost ? normalizePostEntry(nextPost) : null;
const prevArticleTheme = prevNormalizedPost ? getArticleThemeTokens(prevNormalizedPost.experience.theme) : null;
const nextArticleTheme = nextNormalizedPost ? getArticleThemeTokens(nextNormalizedPost.experience.theme) : null;
const prevRevealAccentColor = prevPalette?.accentColor || prevArticleTheme?.accentColor || '#8A9BA8';
const nextRevealAccentColor = nextPalette?.accentColor || nextArticleTheme?.accentColor || '#C5A017';
const nextRevealHeroImage = nextPalette?.textureSrc || nextNormalizedPost?.heroImage || nextPost?.data.featured_image;
const returnToSpiralHref = post.data.card ? `/?card=${encodeURIComponent(post.data.card)}` : '/';
const articleTags = normalizedPost.concepts.length > 0 ? normalizedPost.concepts : normalizedPost.tags;
const articleCanonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const articleImage = normalizedPost.heroImage || post.data.featured_image || '/images/og-default.png';
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: normalizedPost.llm.summary || normalizedPost.excerpt || undefined,
  image: [new URL(articleImage, Astro.site).toString()],
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  mainEntityOfPage: articleCanonicalUrl,
  author: {
    '@type': 'Organization',
    name: 'Tryambakam Noesis',
    url: 'https://tryambakam.space',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Tryambakam Noesis',
    url: 'https://tryambakam.space',
  },
  about: articleTags,
};
const prevFooterEntry = prevPost ? {
  slug: prevPost.id,
  title: prevPost.data.title,
  context: prevCard?.thothName || getArticleExperience(prevNormalizedPost?.articleMode || 'research-essay').label,
  accentColor: prevRevealAccentColor,
} : null;
const nextFooterEntry = nextPost ? {
  slug: nextPost.id,
  title: nextPost.data.title,
  context: nextCard?.thothName || getArticleExperience(nextNormalizedPost?.articleMode || 'research-essay').label,
  accentColor: nextRevealAccentColor,
} : null;

const groupedJourneyCards = sorted
  .filter((p) => {
    const numeral = p.data.card || '';
    return Boolean(numeral && numeral in cardOrder);
  })
  .reduce((groups, p) => {
    const numeral = p.data.card || '?';
    const pal = p.data.card ? getCardPalette(p.data.card) : null;
    const journeyCard = p.data.card ? getCardByNumeral(p.data.card) : null;
    const existing = groups.get(numeral);

    if (!existing) {
      groups.set(numeral, {
        numeral,
        accentColor: pal?.accentColor || '#8A9BA8',
        slug: p.id,
        title: p.data.title,
        cardName: journeyCard?.thothName || 'Journey Entry',
        entryCount: 1,
      });
      return groups;
    }

    existing.entryCount += 1;
    if (p.id === post.id) {
      existing.slug = p.id;
      existing.title = p.data.title;
    }

    return groups;
  }, new Map<string, {
    numeral: string;
    accentColor: string;
    slug: string;
    title: string;
    cardName: string;
    entryCount: number;
  }>());

const journeyCards = Object.entries(cardOrder)
  .sort(([, leftOrder], [, rightOrder]) => leftOrder - rightOrder)
  .map(([numeral]) => groupedJourneyCards.get(numeral))
  .filter(Boolean);
---

<BaseLayout
  title={post.data.title}
  description={normalizedPost.llm.summary || post.data.excerpt}
  ogImage={articleImage}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.date.toISOString()}
  articleTags={articleTags}
  structuredData={articleStructuredData}
>
  <ReadingProgress client:load />
  <SiteHeader />
  {isCardJourney ? (
  <article
    class="relative min-h-screen pt-[clamp(5rem,10vw,6.5rem)]"
    style={cardVars}
    data-element={card?.element || ''}
    data-card={post.data.card || ''}
    data-layout={layout}
  >
    {/* Background layers */}
    <div class="fixed inset-0 -z-10" style={bgGradient} />
    <div class="fixed inset-0 -z-[5] opacity-[0.04] pointer-events-none mix-blend-overlay"
      style="background-image: repeating-conic-gradient(rgba(255,255,255,0.03) 0% 25%, transparent 0% 50%); background-size: 3px 3px;" />
    {palette && (
      <div class="fixed top-1/4 left-1/2 -translate-x-1/2 -z-[3] pointer-events-none"
        style={`width: 60vw; height: 60vh; background: radial-gradient(ellipse, ${palette.blob1Color}22 0%, transparent 70%); filter: blur(80px);`} />
    )}
    <div class="card-hero-effects fixed inset-0 -z-[2] pointer-events-none" />
    <div class="element-ambient" />

    {/* Per-post journey breadcrumb (top-level nav lives in SiteHeader) */}
    {journeyCards.length > 0 && (
      <nav class="post-top-nav relative z-10 flex items-center justify-end">
        <JourneyProgress client:load cards={journeyCards} currentNumeral={post.data.card || ''} currentSlug={post.id} />
      </nav>
    )}

    {/* ═══════════════════════════════════════════
        FULL-WIDTH IMMERSIVE HERO
        Each layout fills the viewport
    ═══════════════════════════════════════════ */}
    <section class="post-intro-section relative w-full">
      <div class="post-intro-shell">
        <div class={`post-intro-grid ${introGridClass}`}>
          <header class="post-header-block">
            <div class="post-header-main">
              {card && (
                <div class="post-numeral-group flex flex-col items-start gap-2 sm:flex-row sm:items-end sm:gap-6 md:gap-8">
                  <span
                    class="text-[44px] sm:text-[60px] md:text-[92px] lg:text-[112px] font-bold leading-none opacity-15"
                    style={`font-family: var(--font-display); color: ${palette?.accentColor || card.color};`}
                  >
                    {card.numeral}
                  </span>
                  <div class="post-numeral-copy">
                    <span class="text-xs uppercase tracking-[0.2em] block"
                      style={`font-family: var(--font-mono); color: ${palette?.accentColor || 'var(--color-sacred-gold)'};`}>
                      {card.thothName}
                    </span>
                    <span class="text-[10px] block mt-0.5"
                      style="font-family: var(--font-mono); color: var(--color-muted-silver);">
                      {card.heroPhase} &middot; {card.keyword}
                    </span>
                  </div>
                </div>
              )}

              <h1
                class="post-title w-full max-w-[20ch] lg:max-w-[18ch] text-[clamp(1.95rem,4vw,3.55rem)] font-semibold leading-[0.96] md:leading-[1.02]"
                style="font-family: var(--font-display); color: var(--color-parchment); text-wrap: balance;"
              >
                {post.data.title}
              </h1>

              {normalizedPost.excerpt && (
                <p class="post-dek">
                  {normalizedPost.excerpt}
                </p>
              )}

              {experience && (
                <div class="post-mobile-context lg:hidden" style="font-family: var(--font-mono); color: var(--color-muted-silver);">
                  <div class="text-[10px] uppercase tracking-[0.18em] opacity-55">
                    {experience.location.name}
                  </div>
                  <div class="text-[11px] opacity-45">
                    {experience.location.detail}
                  </div>
                  {experience.room && (
                    <div class="text-[10px] uppercase tracking-[0.18em] opacity-35">
                      Room {experience.room.number}
                    </div>
                  )}
                </div>
              )}

              <div class="post-meta-row flex flex-wrap items-center gap-2 sm:gap-3 md:gap-5 text-[11px] md:text-xs mb-0"
                style="font-family: var(--font-mono); color: var(--color-muted-silver);">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {post.data.location && (<><span class="opacity-30">/</span><span>{post.data.location}</span></>)}
                {post.data.kosha && (<><span class="opacity-30">/</span><span style="color: var(--color-coherence-emerald);">{post.data.kosha}</span></>)}
                {post.data.identity && (<><span class="opacity-30">/</span><span style="color: var(--color-witness-violet); opacity: 0.7;">{post.data.identity}</span></>)}
                {post.data.suit && (
                  <span class="post-suit-pill rounded text-[10px] uppercase tracking-widest"
                    style={`border: 1px solid ${palette ? `${palette.accentColor}33` : 'rgba(197,160,23,0.2)'}; color: ${palette?.accentColor || 'var(--color-sacred-gold)'};`}>
                    {post.data.suit}
                  </span>
                )}
              </div>
            </div>
          </header>

          {showIntroAside && (
            <div class="post-intro-aside">
              {showIntroHero && (
                <figure class="post-intro-media">
                  {heroImageAsset ? (
                    <Picture
                      src={heroImageAsset}
                      alt={card?.thothName || post.data.title}
                      formats={['avif']}
                      fallbackFormat="webp"
                      widths={[320, 480, 640, 800]}
                      sizes={heroImageSizes}
                      loading="eager"
                      priority
                      class="absolute inset-0 h-full w-full object-cover object-center"
                      style={`opacity: ${layout === 'hermit-minimal' ? '0.18' : '0.58'};`}
                      pictureAttributes={{ class: 'absolute inset-0 block h-full w-full' }}
                    />
                  ) : (
                    <img
                      src={heroImage}
                      alt={card?.thothName || post.data.title}
                      class="absolute inset-0 h-full w-full object-cover object-center"
                      style={`opacity: ${layout === 'hermit-minimal' ? '0.18' : '0.58'};`}
                      loading="eager"
                      decoding="async"
                      sizes={heroImageSizes}
                    />
                  )}
                  <div
                    class="absolute inset-0"
                    style={`background: linear-gradient(180deg, rgba(7,11,29,0.08) 0%, ${palette?.backgroundColor || '#070B1D'}CC 100%);`}
                  />
                </figure>
              )}

              {experience && (
                <div class="post-header-context hidden lg:block" style="font-family: var(--font-mono);">
                  <div class="post-header-context-location text-xs text-[var(--color-muted-silver)] opacity-52 uppercase tracking-[0.2em]">
                    {experience.location.name}
                  </div>
                  <div class="post-header-context-detail text-[10px] text-[var(--color-muted-silver)] opacity-34">
                    {experience.location.detail}
                  </div>
                  {experience.room && (
                    <div class="post-header-context-room text-[10px] uppercase tracking-[0.18em] opacity-28"
                      style={`color: ${palette?.accentColor || 'var(--color-sacred-gold)'}`}
                      title={experience.room.meaning}>
                      Room {experience.room.number}
                    </div>
                  )}
                  <p class="post-header-context-note text-[11px] italic leading-relaxed opacity-34"
                    style="font-family: var(--font-body); color: var(--color-muted-silver);">
                    {experience.sensoryNote}
                  </p>
                </div>
              )}
            </div>
          )}
        </div>

        <div class="post-intro-divider w-full h-px"
          style={`background: linear-gradient(90deg, transparent 5%, ${dividerColor}40 30%, ${dividerColor}40 70%, transparent 95%);`} />
      </div>
    </section>

    {/* ═══════════════════════════════════════════
        CONTENT AREA — LAYOUT-SPECIFIC
    ═══════════════════════════════════════════ */}
    <div class={`post-body-shell w-full ${layout === 'hermit-minimal' ? 'is-hermit' : ''}`}>

      {/* Pull quote — inside content-area so it aligns with prose */}
      {/* Main content + Easter eggs — CSS layout drives structure via [data-layout] */}
      <div class="post-content-area">

        {/* Pull quote — sits above prose, aligned to same column */}
        {experience && layout !== 'hermit-minimal' && (
          <div class="post-pull-quote">
            <blockquote class="text-base md:text-lg italic leading-relaxed max-w-[640px] opacity-35"
              style={`font-family: var(--font-body); color: ${palette?.accentColor || 'var(--color-sacred-gold)'};`}>
              &ldquo;{experience.pullQuote}&rdquo;
            </blockquote>
          </div>
        )}

        <div class={`post-prelude-tools ${hasDesktopReadingSidebar ? 'lg:hidden' : ''}`}>
          <PostTOC client:load />
          <BackToTop client:load />
        </div>

        <div class={`post-reading-shell ${hasDesktopReadingSidebar ? 'is-railed' : 'is-solo'}`}>
          {/* Content column */}
          <div id="post-reading" class="prose-synchronocities w-full">
            <Content />

            {/* Closing line */}
            {experience && (
              <div class="post-closing-line" style={`border-top: 1px solid ${dividerColor}1A;`}>
                <p class="text-sm italic opacity-50" style={`color: ${palette?.accentColor || 'var(--color-muted-silver)'};`}>
                  {experience.closingLine}
                </p>
              </div>
            )}
          </div>

          {/* Easter eggs sidebar — hidden on mobile, visible on desktop */}
          {experience && layout !== 'hermit-minimal' && (
            <aside class="post-reading-rail hidden lg:block">
              <div class="post-rail-tools">
                <PostTOC client:load />
                <BackToTop client:load />
              </div>

              {/* Room marker */}
              {experience.room && (
                <div class="post-rail-room" style={`border-bottom: 1px solid ${dividerColor}15;`}>
                  <div class="post-rail-room-label text-[10px] uppercase tracking-[0.2em]"
                    style={`font-family: var(--font-mono); color: ${palette?.accentColor || 'var(--color-muted-silver)'}; opacity: 0.5;`}>
                    Room
                  </div>
                  <div class="text-2xl font-bold opacity-20"
                    style={`font-family: var(--font-display); color: ${palette?.accentColor};`}>
                    {experience.room.number}
                  </div>
                  <div class="post-rail-room-detail text-[10px] opacity-25 leading-tight"
                    style="font-family: var(--font-mono); color: var(--color-muted-silver);">
                    {experience.room.meaning}
                  </div>
                </div>
              )}

              {/* Easter egg items */}
              <div class="post-rail-egg-list">
                <div class="text-[10px] uppercase tracking-[0.2em]"
                  style={`font-family: var(--font-mono); color: ${palette?.accentColor}; opacity: 0.4;`}>
                  Synchronicities
                </div>
                {experience.easterEggs.map((egg) => (
                  <div class="group cursor-default" title={egg.meaning}>
                    {egg.number && (
                      <span class="text-xs font-bold opacity-25 block"
                        style={`font-family: var(--font-display); color: ${palette?.accentColor};`}>
                        {egg.number}
                      </span>
                    )}
                    <span class="text-[11px] block"
                      style={`font-family: var(--font-mono); color: var(--color-muted-silver); opacity: 0.4;`}>
                      {egg.label}
                    </span>
                    <span class="post-rail-egg-meaning text-[10px] block opacity-0 group-hover:opacity-40 transition-opacity duration-500 leading-tight"
                      style="font-family: var(--font-body); color: var(--color-parchment);">
                      {egg.meaning}
                    </span>
                  </div>
                ))}
              </div>

              {/* Breath pattern */}
              {experience.breathPattern && (
                <div class="post-rail-breath" style={`border-top: 1px solid ${dividerColor}10;`}>
                  <div class="post-rail-breath-label text-[10px] uppercase tracking-[0.2em]"
                    style={`font-family: var(--font-mono); color: ${palette?.accentColor}; opacity: 0.3;`}>
                    Breath
                  </div>
                  <div class="text-lg font-bold opacity-15 tracking-[0.3em]"
                    style={`font-family: var(--font-display); color: ${palette?.accentColor};`}>
                    {experience.breathPattern}
                  </div>
                </div>
              )}
            </aside>
          )}
        </div>
      </div>

      <div class="post-related-area">
        <RelatedPostModules
          currentTitle={post.data.title}
          series={normalizedPost.series}
          related={relatedArchiveRecords}
          seriesCompanions={seriesCompanions}
        />
      </div>

      <PostFooterNav prev={prevFooterEntry} next={nextFooterEntry} returnHref={returnToSpiralHref} />

      {/* Mobile Easter eggs — collapsible at bottom */}
      {experience && layout !== 'hermit-minimal' && (
        <div class="post-mobile-easter-eggs lg:hidden">
          <details class="group">
            <summary class="text-[11px] uppercase tracking-[0.2em] cursor-pointer list-none"
              style={`font-family: var(--font-mono); color: ${palette?.accentColor}; opacity: 0.4;`}>
              <span class="group-open:hidden">&#9656; Synchronicities</span>
              <span class="hidden group-open:inline">&#9662; Synchronicities</span>
            </summary>
            <div class="post-mobile-egg-list" style={`border-left: 1px solid ${dividerColor}20;`}>
              {experience.easterEggs.map((egg) => (
                <div>
                  <span class="text-[11px] block" style="font-family: var(--font-mono); color: var(--color-muted-silver); opacity: 0.5;">
                    {egg.number ? `${egg.number} · ` : ''}{egg.label}
                  </span>
                  <span class="post-mobile-egg-meaning text-[10px] block opacity-35 leading-tight"
                    style="font-family: var(--font-body); color: var(--color-parchment);">
                    {egg.meaning}
                  </span>
                </div>
              ))}
            </div>
          </details>
        </div>
      )}
    </div>

    {/* ═══════════════════════════════════════════
        FOOTER + NEXT POST — Opt-in continuation surface
        Atmospheric transition remains, but navigation is explicit
    ═══════════════════════════════════════════ */}
    {nextPost ? (
      <NextPostReveal
        client:load
        title={nextPost.data.title}
        slug={nextPost.id}
        card={nextPost.data.card}
        cardName={nextCard?.thothName}
        heroPhase={nextCard?.heroPhase}
        accentColor={nextRevealAccentColor}
        heroImage={nextRevealHeroImage}
        excerpt={nextPost.data.excerpt}
        revolution={post.data.revolution}
        tags={post.data.tags}
        returnHref={returnToSpiralHref}
      />
    ) : (
      <footer class="w-full flex flex-col items-center justify-center" style="height: 50vh; gap: 2vh;">
        <span style="font-size: clamp(0.55rem, 0.65vw, 0.7rem); color: var(--color-muted-silver); opacity: 0.3; font-family: var(--font-mono);">
          Revolution {post.data.revolution}
        </span>
        <a href={returnToSpiralHref} class="transition-colors hover:text-[var(--color-sacred-gold)]"
          style="font-size: clamp(0.55rem, 0.65vw, 0.7rem); text-transform: uppercase; letter-spacing: 0.2em; font-family: var(--font-mono); color: var(--color-muted-silver); opacity: 0.4;">
          Return to Spiral
        </a>
      </footer>
    )}

    <ScrollReveal client:load />
  </article>
  ) : (
    <div>
      <NonCardArticleShell
        post={post}
        normalizedPost={normalizedPost}
        Content={Content}
        relatedArchiveRecords={relatedArchiveRecords}
        seriesCompanions={seriesCompanions}
      />

      <PostFooterNav prev={prevFooterEntry} next={nextFooterEntry} returnHref={returnToSpiralHref} />

      {nextPost ? (
        <NextPostReveal
          client:load
          title={nextPost.data.title}
          slug={nextPost.id}
          card={nextPost.data.card}
          cardName={nextCard?.thothName}
          heroPhase={nextCard?.heroPhase}
          accentColor={nextRevealAccentColor}
          heroImage={nextRevealHeroImage}
          excerpt={nextPost.data.excerpt}
          revolution={post.data.revolution}
          tags={post.data.tags}
          returnHref={returnToSpiralHref}
        />
      ) : (
        <footer class="w-full flex flex-col items-center justify-center" style="height: 50vh; gap: 2vh;">
          <span style="font-size: clamp(0.55rem, 0.65vw, 0.7rem); color: var(--color-muted-silver); opacity: 0.3; font-family: var(--font-mono);">
            Revolution {post.data.revolution}
          </span>
          <a href={returnToSpiralHref} class="transition-colors hover:text-[var(--color-sacred-gold)]"
            style="font-size: clamp(0.55rem, 0.65vw, 0.7rem); text-transform: uppercase; letter-spacing: 0.2em; font-family: var(--font-mono); color: var(--color-muted-silver); opacity: 0.4;">
            Return to Spiral
          </a>
        </footer>
      )}

      <ScrollReveal client:load />
    </div>
  )}
</BaseLayout>
