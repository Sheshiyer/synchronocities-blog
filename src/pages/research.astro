---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildArchiveDataset } from '../lib/archive';
import SiteHeader from '../components/SiteHeader.astro';
import ResearchDiscovery from '../components/ResearchDiscovery';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const dataset = buildArchiveDataset(allPosts);
const totalEntries = dataset.records.length;
---

<BaseLayout
  title="Research Library"
  description="The full library — every essay, hub, reference, and field note. Search by title, concept, tag, or cluster."
>
  <SiteHeader />

  <main class="min-h-[100dvh]">
    {/* Hero — concise, leads into the flowing library */}
    <section class="px-6 pt-[clamp(6rem,11vw,9rem)] pb-[clamp(2rem,4vw,3.5rem)] sm:px-10 lg:px-16">
      <div class="mx-auto max-w-[1280px]">
        <div class="grid grid-cols-12 gap-x-6">
          <div class="col-span-12 mb-6 sm:col-span-2 sm:mb-0">
            <span
              class="text-[0.62rem] uppercase"
              style="font-family: var(--font-mono); letter-spacing: 0.32em; color: var(--color-coherence-emerald); opacity: 0.78;"
            >Library</span>
          </div>
          <div class="col-span-12 sm:col-span-10">
            <h1
              class="max-w-[26ch] text-[clamp(1.85rem,3.4vw,2.85rem)] leading-[1.06] tracking-tight text-[var(--color-parchment)]"
              style="font-family: var(--font-display); font-weight: 500;"
            >
              The full library. <em class="not-italic" style="color: var(--color-sacred-gold);">{totalEntries}</em> entries indexed by title, concept, tag, and cluster.
            </h1>
            <p
              class="mt-5 max-w-[58ch] text-[0.98rem] leading-relaxed"
              style="font-family: var(--font-body); color: var(--color-muted-silver); opacity: 0.72;"
            >
              Hover any row to surface its hero image. Search and filters narrow the list in place.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Full library — search + filters + flowing-marquee list of every entry */}
    <section class="px-6 pb-[clamp(6rem,12vw,11rem)] sm:px-10 lg:px-16">
      <div class="mx-auto max-w-[1280px]">
        <ResearchDiscovery dataset={dataset} client:load />
      </div>
    </section>
  </main>
</BaseLayout>
