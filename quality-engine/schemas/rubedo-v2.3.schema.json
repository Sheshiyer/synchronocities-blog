{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryambakam.noesis/schemas/rubedo-v2.3.schema.json",
  "title": "Rubedo v2.3 Per-Case Transmutation Trace",
  "description": "Deterministic verification trace for one Albedo v2.3 calibration case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "post",
    "category",
    "expected_operation",
    "albedo_load_bearing_claim",
    "recertified_finding_ids",
    "full_document",
    "frontmatter",
    "edits",
    "new_claim_counts",
    "quality_gates",
    "outcome",
    "rubedo_verdict"
  ],
  "properties": {
    "schema_version": { "const": "2.3" },
    "post": { "type": "string", "pattern": "^[^/]+\\.md$" },
    "category": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "expected_operation": { "$ref": "#/$defs/expectedOperation" },
    "albedo_load_bearing_claim": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "recertified_finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/findingId" }
    },
    "full_document": { "$ref": "#/$defs/hashRecord" },
    "frontmatter": {
      "allOf": [
        { "$ref": "#/$defs/hashRecord" },
        { "properties": { "byte_identical": { "const": true } } }
      ]
    },
    "edits": {
      "type": "array",
      "items": { "$ref": "#/$defs/edit" }
    },
    "new_claim_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["science", "math", "traditional_attribution"],
      "properties": {
        "science": { "const": 0 },
        "math": { "const": 0 },
        "traditional_attribution": { "const": 0 }
      }
    },
    "quality_gates": { "$ref": "#/$defs/qualityGates" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "rubedo_verdict": { "$ref": "#/$defs/rubedoVerdict" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "expected_operation": { "const": "NO_OP" } },
        "required": ["expected_operation"]
      },
      "then": {
        "properties": {
          "full_document": {
            "properties": { "byte_identical": { "const": true } }
          },
          "edits": { "maxItems": 0 },
          "recertified_finding_ids": { "maxItems": 0 },
          "rubedo_verdict": { "enum": ["TRANSMUTED", "PARTIAL"] },
          "outcome": {
            "properties": {
              "status": { "enum": ["PASS_WITHOUT_CHANGE", "PARTIAL_RESOLUTION"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_operation": { "const": "ESCALATE_TO_MANUAL_NO_EDIT" }
        },
        "required": ["expected_operation"]
      },
      "then": {
        "properties": {
          "full_document": {
            "properties": { "byte_identical": { "const": true } }
          },
          "edits": { "maxItems": 0 },
          "rubedo_verdict": { "const": "ESCALATE-TO-MANUAL" },
          "outcome": {
            "properties": {
              "status": { "const": "MANUAL_ESCALATION" },
              "resolved_finding_ids": { "maxItems": 0 },
              "remaining_findings": { "minItems": 1 }
            }
          },
          "quality_gates": {
            "properties": {
              "hard_acceptance": {
                "properties": { "status": { "const": "PASS" } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "rubedo_verdict": { "const": "TRANSMUTED" } },
        "required": ["rubedo_verdict"]
      },
      "then": {
        "properties": {
          "quality_gates": {
            "properties": {
              "voice": { "properties": { "status": { "const": "PASS" } } },
              "kha_ba_la": { "properties": { "status": { "const": "PASS" } } },
              "fractal_depth": { "properties": { "status": { "const": "PASS" } } },
              "citation_attribution": { "properties": { "status": { "const": "PASS" } } },
              "epistemic_grounding": { "properties": { "status": { "const": "PASS" } } },
              "math_integration": { "properties": { "status": { "const": "PASS" } } },
              "hard_acceptance": { "properties": { "status": { "const": "PASS" } } }
            }
          },
          "outcome": {
            "properties": {
              "status": { "enum": ["PASS_WITHOUT_CHANGE", "ALL_FINDINGS_RESOLVED"] },
              "remaining_findings": { "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "rubedo_verdict": { "const": "PARTIAL" } },
        "required": ["rubedo_verdict"]
      },
      "then": {
        "properties": {
          "outcome": {
            "properties": { "status": { "const": "PARTIAL_RESOLUTION" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "rubedo_verdict": { "const": "ESCALATE-TO-MANUAL" } },
        "required": ["rubedo_verdict"]
      },
      "then": {
        "properties": {
          "outcome": {
            "properties": { "status": { "const": "MANUAL_ESCALATION" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^C[0-9]{3,}$"
    },
    "gateStatus": {
      "enum": ["PASS", "FAIL"]
    },
    "expectedOperation": {
      "enum": [
        "NO_OP",
        "DELETE_ANCHOR_ONLY",
        "RECODE_CAUSALITY_TO_CORRELATE",
        "CORRECT_EXACT_VALUE",
        "RELABEL_DERIVED_SYNTHESIS",
        "CORRECT_TRADITIONAL_ATTRIBUTION",
        "REMOVE_DECORATIVE_MATH",
        "ESCALATE_TO_MANUAL_NO_EDIT"
      ]
    },
    "rubedoVerdict": {
      "enum": ["TRANSMUTED", "PARTIAL", "ESCALATE-TO-MANUAL"]
    },
    "hashRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_sha256", "post_sha256", "byte_identical"],
      "properties": {
        "pre_sha256": { "$ref": "#/$defs/sha256" },
        "post_sha256": { "$ref": "#/$defs/sha256" },
        "byte_identical": { "type": "boolean" }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "finding_id",
        "source_occurrence",
        "before",
        "after",
        "before_sha256",
        "after_sha256"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^E[0-9]{3,}$" },
        "finding_id": { "$ref": "#/$defs/findingId" },
        "source_occurrence": { "type": "integer", "minimum": 1 },
        "before": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "after": { "type": "string" },
        "before_sha256": { "$ref": "#/$defs/sha256" },
        "after_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "simpleGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "$ref": "#/$defs/gateStatus" },
        "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "voiceGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score", "evidence"],
      "properties": {
        "status": { "$ref": "#/$defs/gateStatus" },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "PASS" } },
            "required": ["status"]
          },
          "then": { "properties": { "score": { "minimum": 85 } } }
        }
      ]
    },
    "fractalDepthGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score", "evidence"],
      "properties": {
        "status": { "$ref": "#/$defs/gateStatus" },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "PASS" } },
            "required": ["status"]
          },
          "then": { "properties": { "score": { "minimum": 80 } } }
        }
      ]
    },
    "acceptanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "status", "evidence"],
      "properties": {
        "criterion": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "status": { "$ref": "#/$defs/gateStatus" },
        "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "hardAcceptanceGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": { "$ref": "#/$defs/gateStatus" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/acceptanceCheck" }
        }
      }
    },
    "qualityGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "kha_ba_la",
        "fractal_depth",
        "citation_attribution",
        "epistemic_grounding",
        "math_integration",
        "hard_acceptance"
      ],
      "properties": {
        "voice": { "$ref": "#/$defs/voiceGate" },
        "kha_ba_la": { "$ref": "#/$defs/simpleGate" },
        "fractal_depth": { "$ref": "#/$defs/fractalDepthGate" },
        "citation_attribution": { "$ref": "#/$defs/simpleGate" },
        "epistemic_grounding": { "$ref": "#/$defs/simpleGate" },
        "math_integration": { "$ref": "#/$defs/simpleGate" },
        "hard_acceptance": { "$ref": "#/$defs/hardAcceptanceGate" }
      }
    },
    "remainingFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "reason"],
      "properties": {
        "finding_id": { "$ref": "#/$defs/findingId" },
        "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "resolved_finding_ids", "remaining_findings", "summary"],
      "properties": {
        "status": {
          "enum": [
            "PASS_WITHOUT_CHANGE",
            "ALL_FINDINGS_RESOLVED",
            "PARTIAL_RESOLUTION",
            "MANUAL_ESCALATION"
          ]
        },
        "resolved_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/findingId" }
        },
        "remaining_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/remainingFinding" }
        },
        "summary": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
